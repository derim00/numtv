+void updateFire() {
+  uint8_t* f = s.fire;
+  for (int x = 0; x < k_fireW; x++) {
+    f[(k_fireH - 1) * k_fireW + x] = 36;
+  }
+  for (int y = 1; y < k_fireH; y++) {
+    for (int x = 0; x < k_fireW; x++) {
+      int src = y * k_fireW + x;
+      int p = f[src];
+      uint32_t r = rnd();
+      int decay = r & 3;
+      int dst = src - k_fireW - (static_cast<int>((r >> 2) & 3) - 1);
+      if (dst < 0) {
+        dst = 0;
+      }
+      int v = p - (decay & 1) - ((decay >> 1) & (y < k_fireH / 2 ? 1 : 0));
+      f[dst] = v < 0 ? 0 : v;
+    }
+  }
+}
+
+KDColor fireColor(int v, int x, int y) {
+  if (v <= 0) {
+    return rgb(0x120604);
+  }
+  int t = v * 256 / 36;
+  switch (s.fuel) {
+    case 1: {  // paper: blue-white flames
+      if (t < 90) {
+        return mix(rgb(0x120604), rgb(0x2244AA), t * 256 / 90);
+      }
+      if (t < 180) {
+        return mix(rgb(0x2244AA), rgb(0x9FC4FF), (t - 90) * 256 / 90);
+      }
+      return mix(rgb(0x9FC4FF), rgb(0xFFFFFF), (t - 180) * 256 / 76);
+    }
+    case 2: {  // boron: green
+      if (t < 120) {
+        return mix(rgb(0x120604), rgb(0x0E8A2E), t * 256 / 120);
+      }
+      return mix(rgb(0x0E8A2E), rgb(0xD8FF9E), (t - 120) * 256 / 136);
+    }
+    case 3:  // disco
+      return hsv((v * 10 + static_cast<int>(s.now / 6) + y * 2) % 360, 230,
+                 t > 255 ? 255 : (t < 40 ? t * 4 : 255));
+    default:
+      if (t < 70) {
+        return mix(rgb(0x120604), rgb(0x8A1206), t * 256 / 70);
+      }
+      if (t < 150) {
+        return mix(rgb(0x8A1206), rgb(0xF2600C), (t - 70) * 256 / 80);
+      }
+      if (t < 220) {
+        return mix(rgb(0xF2600C), rgb(0xFFD23A), (t - 150) * 256 / 70);
+      }
+      return mix(rgb(0xFFD23A), rgb(0xFFF8E0), (t - 220) * 256 / 36);
+  }
+}
