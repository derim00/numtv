+void renderBoot(Band& b) {
+  uint32_t t = s.now - s.bootStart;
+  if (t < 1400) {
+    renderStatic(b, t < 900 ? 230 : 230 - (t - 900) * 200 / 500);
+    if (t > 500) {
+      outlinedText(b, "RECHERCHE DES CHA\xC3\x8ENES...", 160, 200,
+                   rgb(0x47FF5A), Small, Align::Center);
+      int found = (t - 500) / 80;
+      char line[30];
+      Str m(line, sizeof(line));
+      m.add("cha\xC3\xAEnes trouv\xC3\xA9\x65s : ").addInt(found);
+      outlinedText(b, line, 160, 216, rgb(0x47FF5A), Small, Align::Center);
+    }
+    return;
+  }
+  // Colour bars, then the ident
+  uint32_t u = t - 1400;
+  static constexpr uint32_t k_bars[7] = {0xC0C0C0, 0xC0C000, 0x00C0C0, 0x00C000,
+                                         0xC000C0, 0xC00000, 0x0000C0};
+  if (u < 900) {
+    for (int i = 0; i < 7; i++) {
+      fill(b, {i * 320 / 7, 0, 320 / 7 + 1, 170}, rgb(k_bars[i]));
+    }
+    for (int i = 0; i < 7; i++) {
+      fill(b, {i * 320 / 7, 170, 320 / 7 + 1, 22},
+           rgb(k_bars[6 - i] & 0x7F7F7F));
+    }
+    fill(b, {0, 192, 320, 48}, rgb(0x101010));
+    fill(b, {40, 196, 60, 40}, rgb(0xFFFFFF));
+    roundFill(b, {120, 80, 80, 40}, 6, rgb(0x000000), 220);
+    text(b, "NUM TV", 160, 91, rgb(0xFFFFFF), Large, Align::Center);
+    return;
+  }
+  u -= 900;
+  // Ident: a dark studio, a spinning ring of colours, the logo zooms in
+  for (int y = b.clip().y; y < b.clip().bottom(); y++) {
+    KDColor c = mix(rgb(0x1A0B2E), rgb(0x05030A), y * 256 / 240);
+    KDColor* row = b.row(y);
+    for (int x = b.clip().x; x < b.clip().right(); x++) {
+      row[x] = c;
+    }
+  }
+  float k = u < 700 ? u / 700.f : 1.f;
+  float ease = 1 - (1 - k) * (1 - k) * (1 - k);
+  for (int i = 0; i < 18; i++) {
+    float a = i * 6.2832f / 18 + u * 0.0012f;
+    float r = 70 + 20 * sinf(u * 0.004f + i);
+    float x = 160 + cosf(a) * r * ease * 1.4f;
+    float y = 104 + sinf(a) * r * ease * 0.8f;
+    ellipse(b, x, y, 9, 9, hsv((i * 20 + u / 6) % 360, 220, 255),
+            static_cast<int>(200 * ease));
+  }
+  int scale = u < 300 ? 1 : (u < 600 ? 2 : 3);
+  Channels::drawLogo(b, 160, 104, scale, (u / 8) % 360);
+  if (u > 1100) {
+    int a = u > 1500 ? 256 : static_cast<int>((u - 1100) * 256 / 400);
+    text(b, "la t\xC3\xA9l\xC3\xA9 qui passe en cours", 160, 178,
+         rgb(0xFFFFFF), Large, Align::Center, k_screenWidth, a);
+    text(b, "(appuie sur une touche)", 160, 204, rgb(0x8A7BA8), Small,
+         Align::Center, k_screenWidth, a);
+  }
+}
+
+/* The CRT turning on or off: the picture is squeezed to a bright line, then
+ * to a dot. k = 0 (dot) .. 1 (full picture). */
+void tubeMask(Band& b, float k) {
+  if (k >= 1.f) {
+    return;
+  }
+  float half;  // half height of the visible picture
+  float halfW;
+  if (k < 0.35f) {
+    float u = k / 0.35f;
+    half = 1.2f;
+    halfW = 4 + u * 156;
+  } else {
+    half = 1.2f + (k - 0.35f) / 0.65f * 120.f;
+    halfW = 160;
+  }
+  int whiten = static_cast<int>((1.f - k) * 220);
+  for (int y = b.clip().y; y < b.clip().bottom(); y++) {
+    KDColor* row = b.row(y);
+    float dy = fabsf(y + 0.5f - 120.f);
+    for (int x = 0; x < k_screenWidth; x++) {
+      float dx = fabsf(x + 0.5f - 160.f);
+      if (dy > half || dx > halfW) {
+        row[x] = KDBlack;
+      } else if (k < 0.35f) {
+        row[x] = KDColor::RGB888(235, 245, 255);
+      } else {
+        blendPixel(row + x, rgb(0xF0F6FF), whiten);
+      }
+    }
+  }
+}
+
+void postProcess(Band& b, int sourceOffset) {
+  const Rect& a = b.area();
+  // Horizontal shift: the slap, the tearing
+  static KDColor tmp[k_screenWidth];
+  for (int y = a.y; y < a.bottom(); y++) {
+    int shift = 0;
+    if (s.now < s.shakeUntil) {
+      shift += s.shakeX;
+    }
+    if (s.glitch == 3) {
+      float w = sinf((y + sourceOffset) * 0.09f + s.now * 0.011f);
+      shift += static_cast<int>(w * w * w * 18);
+      if (((y + s.now / 16) % 53) < 3) {
+        shift += 40;
+      }
+    }
+    KDColor* row = b.row(y);
+    if (shift != 0) {
+      memcpy(tmp, row, sizeof(tmp));
+      for (int x = 0; x < k_screenWidth; x++) {
+        int sx = x - shift;
+        row[x] = (sx >= 0 && sx < k_screenWidth) ? tmp[sx] : KDBlack;
+      }
+    }
+    if (s.glitch == 2) {
+      int src = y + sourceOffset;
+      if (src >= k_screenHeight || src < 0) {
+        for (int x = 0; x < k_screenWidth; x++) {
+          row[x] = KDBlack;
+        }
+      }
+    }
+    if (s.glitch == 4) {
+      for (int x = 0; x < k_screenWidth; x++) {
+        KDColor c = row[x];
+        row[x] = KDColor::RGB888(c.blue(), c.red(), c.green());
+      }
+    }
+    if (s.glitch == 1) {
+      uint32_t h = hash(s.now / 33 * 977u + y * 131u);
+      for (int x = 0; x < k_screenWidth; x++) {
+        h ^= h << 13;
+        h ^= h >> 17;
+        h ^= h << 5;
+        int v = h & 0xFF;
+        blendPixel(row + x, KDColor::RGB888(v, v, v), 110);
+      }
+    }
+    // Scanlines: one row in two is a bit darker
+    if ((y & 1) == 1) {
+      uint16_t* p = reinterpret_cast<uint16_t*>(row);
+      for (int x = 0; x < k_screenWidth; x++) {
+        uint16_t v = p[x];
+        p[x] = v - ((v >> 3) & 0x18E3);
+      }
+    }
+    // The rounded corners of the tube
+    constexpr int k_r = 12;
+    int dyTop = k_r - y;
+    int dyBottom = y - (k_screenHeight - 1 - k_r);
+    int dy = dyTop > 0 ? dyTop : (dyBottom > 0 ? dyBottom : 0);
+    if (dy > 0) {
+      int inset = k_r - static_cast<int>(sqrtf(static_cast<float>(k_r * k_r - dy * dy)));
+      for (int x = 0; x < inset; x++) {
+        row[x] = KDBlack;
+        row[k_screenWidth - 1 - x] = KDBlack;
+      }
+    }
+  }
+}
+
+void renderScene(Band& b) {
+  if (s.booting) {
+    renderBoot(b);
+    return;
+  }
+  if (s.overlay == Overlay::Guide) {
+    renderGuide(b);
+  } else if (s.overlay == Overlay::Teletext) {
+    renderTeletext(b);
+  } else if (zapping()) {
+    renderStatic(b, 240);
+  } else if (s.adActive) {
+    Channels::renderAd(b, s.ad, s.now - s.adStart);
+    uint32_t t = s.now - s.adStart;
+    fill(b, {0, 0, 110, 18}, rgb(0x000000), 170);
+    text(b, "PUBLICIT\xC3\x89", 6, 2, rgb(0xFFE14D), Small);
+    int left = t < k_adDuration ? (k_adDuration - t) / 1000 + 1 : 0;
+    char line[48];
+    Str m(line, sizeof(line));
+    if (t < k_adSkip) {
+      m.add("Passer dans ").addInt((k_adSkip - t) / 1000 + 1).add(" s");
+    } else {
+      m.add("OK : passer la pub >");
+    }
+    fill(b, {186, 210, 134, 22}, rgb(0x000000), 200);
+    text(b, line, 314, 214, rgb(0xFFFFFF), Small, Align::Right);
+    char back[32];
+    Str bm(back, sizeof(back));
+    bm.add("reprise dans ").addInt(left).add(" s");
+    text(b, back, 314, 2, rgb(0xFFFFFF), Small, Align::Right);
+  } else if (s.channel >= k_firstAppChannel) {
+    Channels::renderApp(s.channel - k_firstAppChannel, b);
+  } else {
+    Channels::render(s.channel, b);
+  }
+  drawParticles(b);
+  if (s.overlay == Overlay::StillThere) {
+    renderStillThere(b);
+  }
+  renderOsd(b);
+}
