+}
+
+Str& Str::add(const char* t) {
+  while (t && *t && len < size - 1) {
+    buf[len++] = *t++;
+  }
+  buf[len] = 0;
+  return *this;
+}
+
+Str& Str::addInt(long v) {
+  char tmp[16];
+  int n = 0;
+  bool neg = v < 0;
+  unsigned long u = neg ? -v : v;
+  do {
+    tmp[n++] = '0' + u % 10;
+    u /= 10;
+  } while (u && n < 15);
+  if (neg) {
+    add("-");
+  }
+  while (n > 0 && len < size - 1) {
+    buf[len++] = tmp[--n];
+  }
+  buf[len] = 0;
+  return *this;
+}
+
+namespace {
+
+/* Calls `line(start, length)` for every line of `s` wrapped to `columns`
+ * glyphs; '\n' forces a new line. */
+template <typename F>
+int forEachLine(const char* s, int columns, F line) {
+  int lines = 0;
+  const char* p = s;
+  while (*p) {
+    const char* start = p;
+    const char* lastBreak = nullptr;
+    int g = 0;
+    const char* q = p;
+    while (*q && *q != '\n') {
+      if ((static_cast<uint8_t>(*q) & 0xC0) != 0x80) {
+        if (g == columns) {
+          break;
+        }
+        g++;
+      }
+      if (*q == ' ') {
+        lastBreak = q;
+      }
+      q++;
+    }
+    const char* end;
+    const char* next;
+    if (*q == 0 || *q == '\n') {
+      end = q;
+      next = *q ? q + 1 : q;
+    } else if (lastBreak && lastBreak > start) {
+      end = lastBreak;
+      next = lastBreak + 1;
+    } else {
+      end = q;
+      next = q;
+    }
+    if (!line(start, static_cast<int>(end - start), lines)) {
+      return lines + 1;
+    }
+    lines++;
+    p = next;
+  }
+  return lines;
+}
+
+}  // namespace
+
+int wrappedLines(const char* s, int width, KDFont::Size font) {
+  int columns = width / glyphWidth(font);
+  return forEachLine(s, columns, [](const char*, int, int) { return true; });
+}
+
+int wrapped(Band& b, const char* s, int x, int y, int width, KDColor c,
+            KDFont::Size font, int lineHeight, Align align, int maxLines,
+            int alpha) {
+  if (s == nullptr || s[0] == 0) {
+    return 0;
+  }
+  if (y >= b.clip().bottom() || y + maxLines * lineHeight <= b.clip().y) {
+    return 0;
+  }
+  int columns = width / glyphWidth(font);
+  return forEachLine(s, columns, [&](const char* start, int n, int i) {
+    if (i >= maxLines) {
+      return false;
+    }
+    int yy = y + i * lineHeight;
+    if (yy < b.clip().bottom() && yy + lineHeight > b.clip().y) {
+      char line[128];
+      int m = n < 127 ? n : 127;
+      memcpy(line, start, m);
+      line[m] = 0;
+      int lx = x;
+      if (align == Align::Center) {
+        lx = x + width / 2;
+      } else if (align == Align::Right) {
+        lx = x + width;
+      }
+      text(b, line, lx, yy, c, font, align, k_screenWidth, alpha);
+    }
+    return true;
+  });
+}
+
+/* ================================================================= apps */
+
+void buildApps() {
+  AppsContainer* container = AppsContainer::sharedAppsContainer();
+  int builtin = container->numberOfBuiltinApps();
+  s_numberOfApps = 0;
+  s_calculationIndex = -1;
+  for (int appIndex = 1;
+       appIndex < builtin && s_numberOfApps < k_maxBuiltin; appIndex++) {
+    I18n::Message name =
+        container->appSnapshotAtIndex(PermutedAppSnapshotIndex(appIndex))
+            ->descriptor()
+            ->name();
+    AppSlot& a = s_apps[s_numberOfApps];
+    a.item = {Item::Kind::Builtin, static_cast<int16_t>(appIndex)};
+    a.show = appShow(static_cast<int>(name));
+    if (name == I18n::Message::CalculApp) {
+      s_calculationIndex = s_numberOfApps;
+    }
+    s_numberOfApps++;
+  }
+  s_numberOfBuiltin = s_numberOfApps;
+  int games = container->numberOfExternalApps();
+  for (int i = 0; i < games && s_numberOfApps < k_maxApps; i++) {
+    AppSlot& a = s_apps[s_numberOfApps++];
+    a.item = {Item::Kind::External, static_cast<int16_t>(i)};
+    a.show = nullptr;
+  }
+}
+
+const char* appName(int i) {
+  if (i < 0 || i >= s_numberOfApps) {
+    return "";
+  }
+  AppsContainer* container = AppsContainer::sharedAppsContainer();
+  if (s_apps[i].item.kind == Item::Kind::External) {
+    return container->externalAppAtIndex(s_apps[i].item.index).name();
+  }
+  return I18n::translate(container
+                             ->appSnapshotAtIndex(PermutedAppSnapshotIndex(
+                                 s_apps[i].item.index))
+                             ->descriptor()
+                             ->name());
+}
+
+int numberOfChannels() { return k_numberOfSpecial + s_numberOfApps; }
