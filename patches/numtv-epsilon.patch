+void renderFull(Band& band) {
+  for (int y = 0; y < k_screenHeight; y += Band::k_maxHeight) {
+    Rect area = {0, y, k_screenWidth, Band::k_maxHeight};
+    band.begin(area);
+    Shell::render(band);
+    Ion::Display::pushRect(KDRect(area.x, area.y, area.w, area.h),
+                           band.pixels());
+  }
+}
+
+void powerOffAndLaunch(int index) {
+  s.poweringOff = true;
+  s.powerOffStart = s.now;
+  Band band;
+  while (!s_fake) {
+    s.now = clockMs();
+    if (s.now - s.powerOffStart > k_powerOffDuration + 120) {
+      break;
+    }
+    updateLed();
+    renderFull(band);
+  }
+  s.poweringOff = false;
+  s.launches++;
+  s.lastLaunched = index;
+  s.detachTime = s.now;
+  s_launch = s_apps[index].item;
+}
