+void attach() {
+  s_attached = true;
+  s_launch = k_noItem;
+  s.now = s.last = clockMs();
+  buildApps();
+  s.userBrightness =
+      GlobalPreferences::SharedGlobalPreferences()->brightnessLevel();
+  s.brightness = s.userBrightness;
+  bool first = !s.initialized;
+  if (first) {
+    s.initialized = true;
+    s.random = 0x9E3779B9u ^ Ion::random();
+    if (s.random == 0) {
+      s.random = 1;
+    }
+    s.ledOn = s.flashOn = s.adsOn = true;
+    s.channel = s.previousChannel = ChNews;
+    s.digit = -1;
+    s.lastLaunched = -1;
+    s.birth = s.now;
+    s.booting = true;
+    s.bootStart = s.now;
+    s.powerOnStart = s.now;
+    s.zapStart = s.now - k_zapDuration;
+    s.lastInput = s.now;
+    s.lastAd = s.now;
+    s.nextGlitch = s.now + 50000 + rnd() % 60000;
+    s.foodSeen = Food::produced();
+    Channels::reset();
+    Channels::collectNews(false);
+    Channels::enter(s.channel);
+  } else {
+    // Back from an app: the TV turns on again
+    s.powerOnStart = s.now;
+    s.lastInput = s.now;
+    s.overlay = Overlay::None;
+    s.adActive = false;
+    s.digit = -1;
+    s.glitch = 0;
+    if (s.channel >= k_firstAppChannel + s_numberOfApps) {
+      s.channel = ChNews;
+    }
+    uint32_t away = (s.now - s.detachTime) / 60000;
+    int last = s.lastLaunched;
+    if (last >= 0 && last < s_numberOfApps) {
+      char line[80];
+      Str m(line, sizeof(line));
+      if (away == 0) {
+        m.add("D\xC3\xA9j\xC3\xA0 fini ? Le programme \xC3\xA9tait si nul ?");
+      } else {
+        m.add("Vous regardiez \"").add(channelName(k_firstAppChannel + last));
+        m.add("\" pendant ").addInt(away).add(" min.");
+      }
+      toast(line, 3500);
+    }
+    if (Food::produced() != s.foodSeen) {
+      // New calculations: we interrupt our programmes
+      Channels::collectNews(true);
+      zap(ChNews, false);
+      s.osdUntil = s.now + 2600;
+    } else {
+      Channels::enter(s.channel);
+    }
+  }
+  Shell::frame();
+#if !PLATFORM_DEVICE
+  const char* shots = getenv("NUMTV_SHOTS");
+  if (shots && first) {
+    s_shotDir = shots;
+    photoSession();
+    exit(0);
+  }
+#endif
+}
+
+void detach() {
+  s.detachTime = clockMs();
+  restoreLed();
+  if (s.brightness != s.userBrightness && !s_fake) {
+    Ion::Backlight::setBrightness(s.userBrightness);
+  }
+  s.brightness = s.userBrightness;
+  s_attached = false;
+}
+
+Item takeLaunch() {
+  Item it = s_launch;
+  s_launch = k_noItem;
+  return it;
+}
+
+int framePeriod() {
+  if (s.channel == ChSaver && s.overlay == Overlay::None && !s.adActive) {
+    return 40;
+  }
+  if (s.overlay == Overlay::Guide || s.overlay == Overlay::Teletext) {
+    return 100;
+  }
+  return 30;
+}
+
+bool frame() {
+  if (!s_attached) {
+    return false;
+  }
+  s.now = clockMs();
+  float dt = (s.now - s.last) / 1000.f;
+  if (dt > 0.1f) {
+    dt = 0.1f;
+  }
+  s.last = s.now;
+  if (s.booting && s.now - s.bootStart > k_bootDuration) {
+    s.booting = false;
+    zap(ChNews, false);
+  }
+  if (s.digit >= 0 && s.now > s.digitUntil) {
+    int d = s.digit;
+    s.digit = -1;
+    zap(d);
+  }
+  if (s.adActive && s.now - s.adStart > k_adDuration) {
+    endAd();
+  }
+  if (s.now < s.shakeUntil) {
+    s.shakeX = static_cast<int>(rnd() % 13) - 6;
+    s.shakeY = static_cast<int>(rnd() % 9) - 4;
+  }
+  // The antenna has a life of its own
+  bool busy = s.booting || s.adActive || s.overlay != Overlay::None ||
+              (s.channel == ChQuiz && s.quiz != QuizPhase::Intro &&
+               s.quiz != QuizPhase::Over);
+  if (!s.glitch && !busy && s.now > s.nextGlitch) {
+    s.glitch = 1 + rnd() % 4;
+    s.glitchStart = s.now;
+    s.glitchUntil = s.now + 6000 + rnd() % 5000;
+  }
+  if (s.glitch && s.now > s.glitchUntil) {
+    s.glitch = 0;
+    s.nextGlitch = s.now + 60000 + rnd() % 90000;
+  }
+  // Are you still watching?
+  if (s.overlay == Overlay::None && !busy && s.channel != ChSaver &&
+      s.channel != ChFire && s.now - s.lastInput > k_idleQuestion) {
+    s.overlay = Overlay::StillThere;
+    s.overlayStart = s.now;
+  }
+  if (s.overlay == Overlay::StillThere &&
+      s.now - s.overlayStart > k_idleOff) {
+    s.overlay = Overlay::None;
+    zap(ChSaver);
+    s.osdUntil = 0;
+  }
+  if (!s.booting && !s.adActive && s.channel <= k_numberOfSpecial) {
+    Channels::update(s.channel, dt);
+  }
+  updateParticles(dt);
+  updateLed();
+  updateBacklight();
+  return true;
+}
+
+void render(Band& band) {
+  Rect area = band.area();
+  int offset = 0;
+  if (s.glitch == 2) {
+    offset = static_cast<int>((s.now - s.glitchStart) / 6 % (k_screenHeight + 24));
+  }
+  if (s.now < s.shakeUntil) {
+    offset += s.shakeY;
+  }
+  if (offset != 0) {
+    int src = area.y + offset;
+    if (src >= k_screenHeight + 24) {
+      src -= k_screenHeight + 24;
+    }
+    band.begin({area.x, src, area.w, area.h});
+    renderScene(band);
+    band.begin(area);
+    postProcess(band, src - area.y);
+  } else {
+    renderScene(band);
+    postProcess(band, 0);
+  }
+  // The tube
+  if (s.poweringOff) {
+    uint32_t t = s.now - s.powerOffStart;
+    float k = 1.f - static_cast<float>(t) / k_powerOffDuration;
+    if (k < 0) {
+      fill(band, k_screen, KDBlack);
+      int glow = 120 - static_cast<int>(t - k_powerOffDuration);
+      if (glow > 0) {
+        disc(band, 160, 120, 2, rgb(0xFFFFFF), glow * 2);
+      }
+    } else {
+      tubeMask(band, k);
+    }
+  } else if (s.now - s.powerOnStart < k_powerOnDuration) {
+    float k = static_cast<float>(s.now - s.powerOnStart) / k_powerOnDuration;
+    tubeMask(band, k);
+  }
+}
+
+bool handleEvent(Event e) {
+  if (!s_attached) {
+    return false;
+  }
+  if (!e.isKeyboardEvent() || e == Events::OnOff) {
+    return false;
+  }
+  if (e == Events::Shift || e == Events::Alpha || e == Events::AlphaCaps) {
+    return false;
+  }
+  s.now = clockMs();
+  s.lastInput = s.now;
+  if (s.poweringOff) {
+    return true;
+  }
+  if (s.booting) {
+    if (s.now - s.bootStart > 900) {
+      s.booting = false;
+      zap(ChNews, false);
+    }
+    return true;
+  }
+  if (e == Events::Backspace) {
+    panic();
+    return true;
+  }
+  if (s.overlay == Overlay::StillThere) {
+    s.overlay = Overlay::None;
+    toast("Ouf. La t\xC3\xA9l\xC3\xA9 avait peur d'\xC3\xAAtre seule.", 2000);
+    return true;
+  }
+  if (e == Events::Plus || e == Events::Minus) {
+    volume(e == Events::Plus ? 1 : -1);
+    return true;
+  }
+  if (s.adActive) {
+    if ((e == Events::OK || e == Events::EXE || e == Events::Back) &&
+        s.now - s.adStart >= k_adSkip) {
+      endAd();
+    } else if (s.now - s.adStart < k_adSkip) {
+      toast("On ne zappe pas pendant la pub. C'est la loi.", 1500);
+    }
+    return true;
+  }
+  if (s.overlay == Overlay::Guide) {
+    int n = numberOfChannels();
+    if (e == Events::Up) {
+      s.guideSelected = (s.guideSelected + n - 1) % n;
+    } else if (e == Events::Down) {
+      s.guideSelected = (s.guideSelected + 1) % n;
+    } else if (e == Events::OK || e == Events::EXE) {
+      int ch = guideChannel(s.guideSelected);
+      s.overlay = Overlay::None;
+      if (ch >= k_firstAppChannel) {
+        zap(ch, false);
+        launchChannel(ch);
+      } else {
+        zap(ch);
+      }
+    } else if (e == Events::Back || e == Events::Home ||
+               e == Events::Toolbox) {
+      s.overlay = Overlay::None;
+    }
+    return true;
+  }
+  if (s.overlay == Overlay::Teletext) {
+    if (e == Events::Left) {
+      s.teletextPage = (s.teletextPage + 3) % 4;
+    } else if (e == Events::Right || e == Events::OK || e == Events::EXE) {
+      s.teletextPage = (s.teletextPage + 1) % 4;
+    } else if (e == Events::Back || e == Events::Home ||
+               e == Events::Toolbox) {
+      s.overlay = Overlay::None;
+    } else if (s.teletextPage == 3 && e == Events::One) {
+      s.ledOn = !s.ledOn;
+    } else if (s.teletextPage == 3 && e == Events::Two) {
+      s.flashOn = !s.flashOn;
+    } else if (s.teletextPage == 3 && e == Events::Three) {
+      s.adsOn = !s.adsOn;
+    }
+    return true;
+  }
+  if (e == Events::Back) {
+    s.overlay = Overlay::Guide;
+    s.overlayStart = s.now;
+    s.guideSelected = guideRow(s.channel);
+    return true;
+  }
+  if (e == Events::Toolbox) {
+    s.overlay = Overlay::Teletext;
+    s.overlayStart = s.now;
+    return true;
+  }
+  if (e == Events::XNT) {
+    slapTv();
+    return true;
+  }
+  if (e == Events::Home) {
+    zap(ChNews);
+    return true;
+  }
+  if (e == Events::Ans) {
+    int target = s.channel;
+    while (target == s.channel && numberOfChannels() > 1) {
+      target = guideChannel(rnd() % numberOfChannels());
+    }
+    toast("Zapping au hasard. Le destin choisit.", 1500);
+    zapWithAds(target);
+    return true;
+  }
+  if (s.channel <= k_numberOfSpecial && !zapping() &&
+      Channels::handleEvent(s.channel, e)) {
+    return true;
+  }
+  bool arrowsCaptured =
+      s.channel <= k_numberOfSpecial && Channels::capturesArrows(s.channel);
+  if (!arrowsCaptured && (e == Events::Up || e == Events::Down)) {
+    zapWithAds(nextChannel(s.channel, e == Events::Up ? 1 : -1));
+    return true;
+  }
+  if (s.channel >= k_firstAppChannel && (e == Events::OK || e == Events::EXE)) {
+    launchChannel(s.channel);
+    return true;
+  }
+  const char* t = e.text();
+  bool digitsCaptured =
+      s.channel <= k_numberOfSpecial && Channels::capturesDigits(s.channel);
+  if (!digitsCaptured && t && t[0] >= '0' && t[0] <= '9' && t[1] == 0) {
+    typedDigit(t[0] - '0');
+    return true;
+  }
+  return false;
+}
+
+}  // namespace Shell
+
+}  // namespace Tv
+}  // namespace Home
