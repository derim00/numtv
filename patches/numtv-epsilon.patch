+void renderNews(Band& b) {
+  uint32_t t = s.now - s.storyStart;
+  // Studio
+  gradient(b, 0x0A1F4A, 0x02081A, 0, 170);
+  for (int i = 0; i < 9; i++) {
+    int x = 20 + i * 36;
+    fill(b, {x, 30, 1, 140}, rgb(0x3A6BD6), 40);
+  }
+  for (int i = 0; i < 5; i++) {
+    fill(b, {0, 40 + i * 28, k_screenWidth, 1}, rgb(0x3A6BD6), 40);
+  }
+  // A spinning globe behind the anchor
+  float gx = 92, gy = 76;
+  ellipse(b, gx, gy, 58, 58, rgb(0x1E4FB5), 90);
+  for (int i = 0; i < 6; i++) {
+    float ph = s.now * 0.0008f + i * k_pi / 6;
+    float rx = 58 * fabsf(cosf(ph));
+    if (rx > 2) {
+      ellipse(b, gx, gy, rx, 58, rgb(0x6FA0FF), 30);
+      ellipse(b, gx, gy, rx - 1.5f, 56.5f, rgb(0x1E4FB5), 30);
+    }
+  }
+  const char *tag, *body, *inset;
+  uint8_t mood;
+  storyAt(s.storyShown % playlistLength(), &tag, &body, &inset, &mood);
+  int len = strlen(body);
+  int shown = static_cast<int>(t / 22);
+  bool talking = shown < len;
+  drawAnchor(b, 92, 84, talking, s.now, 0x26304A, 0x3B2A20);
+  // Desk
+  float dx[4] = {0, 320, 320, 0};
+  float dy[4] = {150, 140, 172, 172};
+  polygon(b, dx, dy, 4, rgb(0xC9D6F2));
+  fill(b, {0, 166, k_screenWidth, 6}, rgb(0x8EA3D1));
+  text(b, "NUM 1", 92, 150, rgb(0x0A1F4A), Small, Align::Center);
+  // The inset picture
+  Rect box = {176, 36, 132, 82};
+  uint32_t moodColors[4] = {0x2F6FE0, 0xE0262F, 0x2DBE5A, 0x9B3CE0};
+  fill(b, {box.x - 3, box.y - 3, box.w + 6, box.h + 6}, rgb(0xFFFFFF));
+  fill(b, box, rgb(moodColors[mood]));
+  for (int i = 0; i < 6; i++) {
+    int yy = box.y + ((s.now / 30 + i * 14) % box.h);
+    fill(b, {box.x, yy, box.w, 1}, rgb(0xFFFFFF), 40);
+  }
+  if (inset) {
+    text(b, "R\xC3\x89SULTAT", box.x + box.w / 2, box.y + 8, rgb(0xFFFFFF),
+         Small, Align::Center, box.w);
+    int w = textWidth(inset, Large);
+    if (w * 2 <= box.w - 8) {
+      bigShadow(b, inset, box.x + box.w / 2, box.y + 28, 2, rgb(0xFFFFFF));
+    } else {
+      text(b, inset, box.x + box.w / 2, box.y + 36, rgb(0xFFFFFF), Large,
+           Align::Center, box.w - 6);
+    }
+  } else {
+    static constexpr const char* k_symbols[] = {"?!", "\xCF\x80", "%", "x^2", "!!", "0/20"};
+    const char* sym = k_symbols[(s.storyShown + s.fakeStory) % count(k_symbols)];
+    bigShadow(b, sym, box.x + box.w / 2, box.y + 14, 3, rgb(0xFFFFFF));
+  }
+  // Live
+  channelBug(b, "NUM 1", 0xFFFFFF);
+  if ((s.now / 600) % 2) {
+    disc(b, 72, 18, 4, rgb(0xFF2020));
+  }
+  text(b, "EN DIRECT", 80, 11, rgb(0xFFFFFF), Small);
+  // Lower third
+  KDColor tagColor = mood == 1 ? rgb(0xE0262F)
+                    : mood == 2 ? rgb(0x2DBE5A)
+                    : mood == 3 ? rgb(0x9B3CE0)
+                                : rgb(0xD7263D);
+  int tagW = textWidth(tag, Small) + 12;
+  fill(b, {6, 160, tagW, 16}, tagColor);
+  text(b, tag, 12, 161, rgb(0xFFFFFF), Small);
+  fill(b, {6, 176, 308, 48}, rgb(0xF6F6F6));
+  char visible[128];
+  int n = shown < len ? shown : len;
+  n = n > 126 ? 126 : n;
+  memcpy(visible, body, n);
+  // Never cut a UTF-8 character
+  while (n > 0 && (static_cast<uint8_t>(visible[n]) & 0xC0) == 0x80 &&
+         n < len) {
+    n--;
+  }
+  visible[n] = 0;
+  wrapped(b, visible, 10, 178, 300, rgb(0x101010), Small, 15, Align::Left, 3);
+  if (t < 3000 && s.storyShown % playlistLength() == 0) {
+    // Who is it?
+    fill(b, {tagW + 10, 160, 150, 16}, rgb(0x0A1F4A));
+    text(b, "G\xC3\xA9rard \xC3\x89quation", tagW + 16, 161, rgb(0xFFFFFF),
+         Small);
+  }
+  // Ticker
+  fill(b, {0, 224, k_screenWidth, 16}, rgb(0x0A1F4A));
+  if (s_tickerTotal > 0) {
+    int offset = static_cast<int>((s.now / 18) % s_tickerTotal);
+    int x = 320 - offset;
+    for (int pass = 0; pass < 2; pass++) {
+      for (int i = 0; i < count(k_ticker); i++) {
+        if (x < 320 && x + s_tickerWidths[i] > 0) {
+          text(b, k_ticker[i], x, 225, i == 0 ? rgb(0xFFC234) : rgb(0xFFFFFF),
+               Small);
+        }
+        x += s_tickerWidths[i];
+      }
+    }
+  }
+  // FLASH SPECIAL: we interrupt our programmes
+  if (s.now < s.flashSpecialUntil) {
+    if ((s.now / 250) % 2) {
+      fill(b, {0, 82, k_screenWidth, 48}, rgb(0xE0262F), 235);
+      bigShadow(b, "FLASH SP\xC3\x89\x43IAL", 160, 85, 2, rgb(0xFFFFFF));
+    } else {
+      fill(b, {0, 82, k_screenWidth, 48}, rgb(0xFFFFFF), 235);
+      text(b, "Nous interrompons nos programmes", 160, 90, rgb(0xE0262F),
+           Small, Align::Center);
+      text(b, "pour vos calculs.", 160, 106, rgb(0xE0262F), Small,
+           Align::Center);
+    }
+  }
+}
