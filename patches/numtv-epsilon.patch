+void cloud(Band& b, float x, float y, float k, KDColor c) {
+  ellipse(b, x - 7 * k, y + 2 * k, 8 * k, 6 * k, c);
+  ellipse(b, x + 1 * k, y - 3 * k, 9 * k, 8 * k, c);
+  ellipse(b, x + 9 * k, y + 2 * k, 8 * k, 6 * k, c);
+  fill(b, {static_cast<int>(x - 7 * k), static_cast<int>(y + 1 * k),
+           static_cast<int>(16 * k), static_cast<int>(7 * k)},
+       c);
+}
