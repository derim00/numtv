+void setLed(KDColor c) {
+  if (!s.ledSet || static_cast<uint16_t>(c) != s.ledLast) {
+    if (!s_fake) {
+      Ion::LED::setColor(c);
+    }
+    s.ledLast = static_cast<uint16_t>(c);
+    s.ledSet = true;
+  }
+}
+
+void restoreLed() {
+  if (s.ledSet) {
+    if (!s_fake) {
+      Ion::LED::updateColorWithPlugAndCharge();
+    }
+    s.ledSet = false;
+  }
+}
+
+bool zapping() { return s.now - s.zapStart < k_zapDuration; }
+
+void updateLed() {
+  if (!s.ledOn || examMode() || !s_attached) {
+    restoreLed();
+    return;
+  }
+  KDColor c = KDBlack;
+  int k = 0;
+  if (s.booting) {
+    uint32_t t = s.now - s.bootStart;
+    c = rgb(0xFFFFFF);
+    k = t < 1300 ? (hash(s.now / 60) & 0xFF) : 0;
+    if (t >= 1300) {
+      c = hsv((s.now / 3) % 360, 255, 255);
+      k = 140;
+    }
+  } else if (s.poweringOff) {
+    c = rgb(0xFFFFFF);
+    k = 255 - 255 * static_cast<int>(s.now - s.powerOffStart) /
+                  static_cast<int>(k_powerOffDuration);
+    if (k < 0) {
+      k = 0;
+    }
+  } else if (zapping() || s.glitch == 1) {
+    c = rgb(0xFFFFFF);
+    k = hash(s.now / 40) & 0x7F;
+  } else if (s.adActive) {
+    c = hsv((s.now / 5) % 360, 255, 255);
+    k = 90;
+  } else if (s.channel <= k_numberOfSpecial) {
+    uint16_t c16 = Channels::ledColor(s.channel, &k);
+    c = KDColor::RGB16(c16);
+  }
+  if (k <= 0) {
+    restoreLed();
+    return;
+  }
+  if (k > 255) {
+    k = 255;
+  }
+  setLed(KDColor::RGB888(c.red() * k / 255, c.green() * k / 255,
+                         c.blue() * k / 255));
+}
+
+void updateBacklight() {
+  int target = s.userBrightness;
+  if (!examMode() && s.flashOn) {
+    if (s.now < s.flashUntil) {
+      target = Ion::Backlight::MaxBrightness;
+    }
+    if (s.overlay == Overlay::StillThere) {
+      target = s.userBrightness / 2;
+    }
+  }
+  if (target < 8) {
+    target = 8;
+  }
+  if (target != s.brightness) {
+    s.brightness = target;
+    if (!s_fake) {
+      Ion::Backlight::setBrightness(target);
+    }
+  }
+}
