+    "T\xC3\x89L\xC3\x89-ACHAT",
+    "LA ROUE",
+    "D\xC3\x89TECTOR 3000",
+    "EXCUSOMATIC",
+    "LE GRAND QUIZ",
+    "FEU DE CHEMIN\xC3\x89\x45",
+    "\xC3\x89\x43RAN DE VEILLE"};
+}
+
+const char* channelName(int channel) {
+  if (channel >= 1 && channel <= k_numberOfSpecial) {
+    return k_channelNames[channel - 1];
+  }
+  int i = channel - k_firstAppChannel;
+  if (i >= 0 && i < s_numberOfApps) {
+    if (s_apps[i].show) {
+      return s_apps[i].show->title;
+    }
+    return appName(i);
+  }
+  return "";
+}
+
+/* ============================================================ particles */
+
+void burst(float x, float y, int n, int hue) {
+  for (Particle& p : s.particles) {
+    if (n <= 0) {
+      break;
+    }
+    if (p.life > 0) {
+      continue;
+    }
+    float a = frnd() * 6.2832f;
+    float v = 60 + frnd() * 200;
+    p.x = x;
+    p.y = y;
+    p.vx = cosf(a) * v;
+    p.vy = sinf(a) * v - 120;
+    p.maxLife = p.life = 900 + rnd() % 900;
+    int h = hue < 0 ? static_cast<int>(rnd() % 360) : hue + (rnd() % 60) - 30;
+    p.rgb565 = static_cast<uint16_t>(hsv((h + 360) % 360, 200, 255));
+    p.size = 2 + rnd() % 3;
+    n--;
+  }
+}
