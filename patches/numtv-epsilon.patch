+void quizBeams(Band& b) {
+  gradient(b, 0x08103A, 0x000008);
+  for (int i = 0; i < 6; i++) {
+    float a = s.now * 0.0004f + i * k_pi / 3;
+    float xs[3] = {160, 160 + cosf(a) * 260 - sinf(a) * 30,
+                   160 + cosf(a) * 260 + sinf(a) * 30};
+    float ys[3] = {60, 60 + sinf(a) * 260 + cosf(a) * 30,
+                   60 + sinf(a) * 260 - cosf(a) * 30};
