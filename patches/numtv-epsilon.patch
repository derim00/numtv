+
+constexpr const char* k_lieLines[] = {
+    "Il ment comme il respire.",
+    "Le nez s'allonge. Mesure : 3 cm.",
+    "Certifi\xC3\xA9 par 3 experts et un pigeon.",
+    "M\xC3\xAAme la calculatrice n'y croit pas.",
+    "Niveau de mensonge : l\xC3\xA9gendaire.",
+};
+constexpr const char* k_truthLines[] = {
+    "V\xC3\xA9rit\xC3\xA9 absolue. Rare. Encadrez-le.",
+    "Aucun mensonge. C'est presque suspect.",
+    "C'est vrai. Le d\xC3\xA9tecteur est aussi surpris.",
+    "100 % sinc\xC3\xA8re. Ou alors tr\xC3\xA8s fort.",
+};
+constexpr uint32_t k_scanDuration = 3200;
+
+float polygraph(float x, float t, float amp) {
+  return sinf(x * 0.11f + t * 3.1f) * 6 * amp +
+         sinf(x * 0.37f + t * 7.3f) * 3 * amp +
+         ((hash(static_cast<int>(x + t * 40)) & 15) - 7.5f) * 0.6f * amp;
+}
+
+void renderDetector(Band& b) {
+  gradient(b, 0x062A26, 0x010D0B);
+  for (int x = 0; x < k_screenWidth; x += 16) {
+    fill(b, {x, 0, 1, k_screenHeight}, rgb(0x1DE9B6), 22);
+  }
+  for (int y = 0; y < k_screenHeight; y += 16) {
+    fill(b, {0, y, k_screenWidth, 1}, rgb(0x1DE9B6), 22);
+  }
+  channelBug(b, "NUM 5", 0x1DE9B6);
+  text(b, "D\xC3\x89TECTOR 3000", 70, 8, rgb(0x1DE9B6), Large);
+  text(b, "homologu\xC3\xA9 par personne", 70, 26, rgb(0x6FBFAF), Small);
+  /* The secret: the full stop after the subtitle shows how the machine is
+   * rigged (only its owner knows): white random, green truth, red lie. */
+  KDColor dot = s.rig == 0 ? rgb(0x39D96B) : (s.rig == 1 ? rgb(0xD95050) : rgb(0x6FBFAF));
+  fill(b, {70 + 22 * 7, 36, 2, 2}, dot);
+  uint32_t t = s.scanning ? s.now - s.scanStart : 0;
+  float k = s.scanning ? (t > k_scanDuration ? 1.f : t / (float)k_scanDuration) : 0.f;
+  // Fingerprint pad
+  Rect pad = {16, 52, 104, 120};
+  roundFill(b, pad, 10, rgb(0x0B3B34));
+  roundFrame(b, pad, 10, rgb(0x1DE9B6));
+  b.setClip({pad.x + 6, pad.y + 6, pad.w - 12, pad.h - 12});
+  KDColor ridge = s.scanning ? rgb(0x7CFFD9) : rgb(0x2E8F7E);
+  for (int i = 1; i < 9; i++) {
+    float r = i * 5.5f;
+    arc(b, 68 + (i % 2), 114 - i * 0.8f, r, 1.4f, 0, ridge, 220);
+  }
+  if (s.scanning) {
+    int sy = pad.y + 6 + static_cast<int>((pad.h - 12) * (0.5f + 0.5f * sinf(t * 0.006f)));
+    fill(b, {pad.x, sy - 1, pad.w, 3}, rgb(0xFFFFFF), 220);
+    fill(b, {pad.x, sy - 6, pad.w, 12}, rgb(0x1DE9B6), 60);
+  }
+  b.resetClip();
+  text(b, s.scanning ? "ANALYSE..." : "DOIGT SUR OK", 68, 176,
+       rgb(0x1DE9B6), Small, Align::Center);
+  // Polygraph paper
+  Rect paper = {132, 52, 176, 100};
+  fill(b, paper, rgb(0xF2F0E6));
+  for (int x = paper.x; x < paper.right(); x += 11) {
+    fill(b, {x, paper.y, 1, paper.h}, rgb(0xF29D9D), 120);
+  }
+  for (int y = paper.y; y < paper.bottom(); y += 11) {
+    fill(b, {paper.x, y, paper.w, 1}, rgb(0xF29D9D), 120);
+  }
+  float time = s.now / 1000.f;
+  float amp = s.scanning ? 1.f + 2.5f * k : 0.35f;
+  if (s.verdict == 1 && s.now - s.verdictStart < 6000) {
+    amp = 4.f;
+  }
+  b.setClip(paper);
+  float prevY = 0;
+  for (int x = 0; x <= paper.w; x += 4) {
+    float y = paper.y + paper.h / 2 + polygraph(x + time * 60, time, amp);
+    y = y < paper.y + 2 ? paper.y + 2 : (y > paper.bottom() - 2 ? paper.bottom() - 2 : y);
+    if (x > 0) {
+      line(b, paper.x + x - 4, prevY, paper.x + x, y, 1.6f, rgb(0x1A1A80));
+    }
+    prevY = y;
+  }
+  b.resetClip();
+  // Readings
+  int bpm = 72 + static_cast<int>(k * 60) + static_cast<int>(hash(s.now / 400) % 5);
+  char line1[30];
+  Str m(line1, sizeof(line1));
+  m.add("POULS  ").addInt(bpm).add(" BPM");
+  text(b, line1, 136, 158, rgb(0x1DE9B6), Small);
+  char line2[30];
+  Str m2(line2, sizeof(line2));
+  m2.add("SUEUR  ").addInt(static_cast<int>(8 + k * 80)).add(" %");
+  text(b, line2, 136, 174, rgb(0x1DE9B6), Small);
+  // Progress
+  fill(b, {16, 196, 292, 12}, rgb(0x0B3B34));
+  fill(b, {16, 196, static_cast<int>(292 * k), 12}, rgb(0x1DE9B6));
+  const char* hint = s.scanning
+                         ? "Garde le doigt sur OK..."
+                         : "Pose ta question, puis garde OK appuy\xC3\xA9.";
+  text(b, hint, 160, 214, rgb(0xBFEDE4), Small, Align::Center);
+  // The verdict
+  if (s.verdict >= 0 && !s.scanning) {
+    uint32_t vt = s.now - s.verdictStart;
+    if (vt < 7000) {
+      bool blink = (vt / 220) % 2 == 0 || vt > 1500;
+      KDColor c = s.verdict == 0 ? rgb(0x22C55E)
+                  : s.verdict == 1 ? rgb(0xEF2D2D)
+                                   : rgb(0xF5A524);
+      Rect box = {18, 62, 284, 104};
+      if (blink) {
+        roundFill(b, box, 10, c);
+      } else {
+        roundFill(b, box, 10, rgb(0x000000));
+      }
+      roundFrame(b, box, 10, rgb(0xFFFFFF));
+      const char* word = s.verdict == 0   ? "V\xC3\x89RIT\xC3\x89"
+                         : s.verdict == 1 ? "MENSONGE"
+                                          : "INTERROMPU";
+      bigShadow(b, word, 160, 70, 3, rgb(0xFFFFFF));
+      const char* sub = s.verdict == 0
+                            ? k_truthLines[s.verdictLine % count(k_truthLines)]
+                        : s.verdict == 1
+                            ? k_lieLines[s.verdictLine % count(k_lieLines)]
+                            : "Le doigt a fui. Tricheur d\xC3\xA9tect\xC3\xA9.";
+      wrapped(b, sub, 26, 130, 268, rgb(0xFFFFFF), Small, 15, Align::Center, 2);
+    }
+  }
+}
+
+void updateDetector() {
+  if (!s.scanning) {
+    return;
+  }
+  Ion::Keyboard::State keys = scanKeys();
+  bool held = keys.keyDown(Key::OK) || keys.keyDown(Key::EXE);
+  uint32_t t = s.now - s.scanStart;
+  if (!held && t < k_scanDuration) {
+    s.scanning = false;
+    s.verdict = 2;
+    s.verdictStart = s.now;
+    return;
+  }
+  if (t >= k_scanDuration) {
+    s.scanning = false;
+    int v = s.rig >= 0 ? s.rig : static_cast<int>(rnd() % 2);
+    s.verdict = v;
+    s.verdictStart = s.now;
+    s.verdictLine = rnd() & 0xFFFF;
+    s.rig = -1;
+    if (v == 1) {
+      s.lies++;
+    } else {
+      s.truths++;
+    }
+    flash(250);
+    if (v == 0) {
+      burst(160, 110, 30, 130);
+    }
+  }
+}
