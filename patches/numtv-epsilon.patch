+/* ============================================================ utilities */
+
+uint32_t rnd() {
+  s.random ^= s.random << 13;
+  s.random ^= s.random >> 17;
+  s.random ^= s.random << 5;
+  return s.random;
+}
+
+float frnd() { return (rnd() & 0xFFFF) / 65535.f; }
+
+uint32_t hash(uint32_t x) {
+  x ^= x >> 16;
+  x *= 0x7feb352dU;
+  x ^= x >> 15;
+  x *= 0x846ca68bU;
+  x ^= x >> 16;
+  return x;
+}
+
+bool examMode() {
+  return ExamModeManager::ExamMode().ruleset() != Ion::ExamMode::Ruleset::Off;
+}
