+/* =========================================================== the remote */
+
+bool isAppChannel(int c) {
+  return c >= k_firstAppChannel && c < k_firstAppChannel + s_numberOfApps;
+}
+
+bool isValidChannel(int c) {
+  return (c >= 1 && c <= k_numberOfSpecial) || isAppChannel(c);
+}
+
+void zap(int target, bool withStatic = true) {
+  if (!isValidChannel(target)) {
+    return;
+  }
+  if (target != s.channel) {
+    s.previousChannel = s.channel;
+  }
+  s.channel = target;
+  s.channelStart = s.now;
+  s.zapStart = withStatic ? s.now : s.now - k_zapDuration;
+  s.osdUntil = s.now + 2600;
+  s.digit = -1;
+  s.zaps++;
+  Channels::enter(target);
+}
+
+void startAd(int pending) {
+  s.adActive = true;
+  s.ad = rnd() % Channels::numberOfAds();
+  s.adStart = s.now;
+  s.lastAd = s.now;
+  s.ads++;
+  s.pendingChannel = pending;
+  s.zapStart = s.now;
+}
+
+void endAd() {
+  s.adActive = false;
+  zap(s.pendingChannel);
+}
+
+// Zapping with the arrows or Ans: sometimes, an ad break
+void zapWithAds(int target) {
+  if (s.adsOn && s.zaps > 4 && s.now - s.lastAd > 80000 && rnd() % 5 == 0) {
+    startAd(target);
+    return;
+  }
+  zap(target);
+}
+
+int nextChannel(int c, int dir) {
+  int n = numberOfChannels();
+  // Channels 1..9 then 10..9+apps: one list
+  int i = c <= k_numberOfSpecial ? c - 1 : c - k_firstAppChannel + 9;
+  i = (i + dir + n) % n;
+  return i < k_numberOfSpecial ? i + 1 : i - 9 + k_firstAppChannel;
+}
+
+int guideChannel(int row) {
+  return row < k_numberOfSpecial ? row + 1 : row - 9 + k_firstAppChannel;
+}
+
+int guideRow(int channel) {
+  return channel <= k_numberOfSpecial ? channel - 1
+                                      : channel - k_firstAppChannel + 9;
+}
+
+void typedDigit(int d) {
+  int maxChannel = k_firstAppChannel + s_numberOfApps - 1;
+  if (s.digit >= 0) {
+    int target = s.digit * 10 + d;
+    s.digit = -1;
+    if (isValidChannel(target)) {
+      zap(target);
+    } else {
+      char line[60];
+      Str m(line, sizeof(line));
+      m.add("Cha\xC3\xAEne ").addInt(target).add(" : aucun signal. Essaie 1 \xC3\xA0 ").addInt(maxChannel).add(".");
+      toast(line, 2500);
+      s.zapStart = s.now;
+    }
+    return;
+  }
+  if (d == 0) {
+    // 0: the previous channel, like on a real remote
+    zap(s.previousChannel);
+    return;
+  }
+  if (d * 10 > maxChannel) {
+    zap(d);
+    return;
+  }
+  s.digit = d;
+  s.digitUntil = s.now + 1300;
+}
+
+void slapTv() {
+  s.shakeUntil = s.now + 380;
+  s.hits++;
+  if (s.glitch) {
+    if (rnd() % 4 != 0) {
+      s.glitch = 0;
+      s.nextGlitch = s.now + 60000 + rnd() % 90000;
+      static constexpr const char* k_fixed[] = {
+          "CLONK ! \xC3\x87\x61 remarche. La technique ancestrale.",
+          "Paf ! Image r\xC3\xA9par\xC3\xA9\x65. Tu es ing\xC3\xA9nieur ?",
+          "BAM. La t\xC3\xA9l\xC3\xA9 a eu peur, elle remarche."};
+      toast(k_fixed[rnd() % 3], 2600);
+    } else {
+      s.glitch = 1 + rnd() % 4;
+      toast("A\xC3\x8F\x45. \xC3\x87\x61 n'a rien arrang\xC3\xA9. Encore !", 2200);
+    }
+    return;
+  }
+  if (rnd() % 4 == 0) {
+    s.glitch = 1 + rnd() % 4;
+    s.glitchStart = s.now;
+    s.glitchUntil = s.now + 7000;
+    toast("Bravo. Tu l'as cass\xC3\xA9\x65.", 2200);
+    return;
+  }
+  static constexpr const char* k_bonk[] = {
+      "Bonk.", "La t\xC3\xA9l\xC3\xA9 te juge.",
+      "Elle marchait tr\xC3\xA8s bien, h\xC3\xA9 !",
+      "Violence gratuite sur t\xC3\xA9l\xC3\xA9viseur."};
+  toast(k_bonk[rnd() % 4], 1800);
+}
+
+void volume(int dir) {
+  constexpr int k_step =
+      Ion::Backlight::MaxBrightness / GlobalPreferences::NumberOfBrightnessStates;
+  int v = s.userBrightness + dir * k_step;
+  v = clampi(v, k_step, Ion::Backlight::MaxBrightness);
+  s.userBrightness = v;
+  if (!s_fake) {
+    GlobalPreferences::SharedGlobalPreferences()->setBrightnessLevel(v);
+  }
+  s.volumeUntil = s.now + 2000;
+}
