+void Channels::drawLogo(Band& b, int cx, int cy, int scale, int hue,
+                        int alpha) {
+  int w = 44 * scale, h = 30 * scale;
+  Rect body = {cx - w / 2, cy - h / 2, w, h};
+  line(b, cx, cy - h / 2, cx - 12 * scale, cy - h / 2 - 12 * scale, 1.2f * scale,
+       rgb(0xDDDDDD), alpha);
+  line(b, cx, cy - h / 2, cx + 10 * scale, cy - h / 2 - 14 * scale, 1.2f * scale,
+       rgb(0xDDDDDD), alpha);
+  roundFill(b, body, 5 * scale, hsv(hue, 200, 235), alpha);
+  Rect screen = {body.x + 3 * scale, body.y + 3 * scale, 32 * scale, 24 * scale};
+  roundFill(b, screen, 4 * scale, rgb(0x101018), alpha);
+  disc(b, body.right() - 4 * scale, body.y + 8 * scale, scale + 1, rgb(0xFFFFFF), alpha);
+  disc(b, body.right() - 4 * scale, body.y + 16 * scale, scale + 1, rgb(0xFFFFFF), alpha);
+  bigText(b, "NUM", screen.x + screen.w / 2, screen.y + 3 * scale, scale,
+          rgb(0xFFFFFF), Align::Center, alpha);
+  if (scale >= 2) {
+    text(b, "TV", cx, body.bottom() + 2, rgb(0xFFFFFF), Large, Align::Center,
+         k_screenWidth, alpha);
+  }
