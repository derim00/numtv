+void addCalcStory(const char* in, const char* out) {
+  char textBuf[120];
+  char inset[30];
+  {
+    Str m(inset, sizeof(inset));
+    m.add(out);
+  }
+  const char* tag = "INFO";
+  uint8_t mood = 0;
+  double v = 0;
+  bool number = parseNumber(out, &v);
+  const char* tpl = nullptr;
+  if (strcmp(out, "undef") == 0 || contains(out, "nd\xC3\xA9")) {
+    tag = "ALERTE";
+    mood = 1;
+    tpl = "Division interdite : @I a donn\xC3\xA9 undef. La classe est \xC3\xA9vacu\xC3\xA9\x65, l'univers tient bon.";
+  } else if (contains(out, "\xE2\x88\x9E")) {
+    tag = "INFINI";
+    mood = 3;
+    tpl = "Un \xC3\xA9l\xC3\xA8ve obtient l'infini avec @I. Les scientifiques cherchent encore la fin.";
+  } else if (number) {
+    bool integer = fabs(v - floor(v + 0.5)) < 1e-9 && fabs(v) < 1e15;
+    long n = integer ? static_cast<long>(floor(v + 0.5)) : 0;
+    if (integer && n == 42) {
+      tag = "EXCLUSIF";
+      mood = 2;
+      tpl = "Un \xC3\xA9l\xC3\xA8ve d\xC3\xA9\x63ouvre le sens de la vie : @I = 42. Les philosophes au ch\xC3\xB4mage.";
+    } else if (integer && n == 666) {
+      tag = "ALERTE";
+      mood = 1;
+      tpl = "Calcul d\xC3\xA9moniaque (666) d\xC3\xA9tect\xC3\xA9 en plein cours. Un exorciste est en route.";
+    } else if (integer && n == 2 && strcmp(in, "1+1") == 0) {
+      tag = "SCANDALE";
+      mood = 1;
+      tpl = "Un lyc\xC3\xA9\x65n a sorti sa calculatrice pour 1+1. Ses parents r\xC3\xA9\x61gissent.";
+    } else if (integer && n == 69) {
+      tag = "SOCI\xC3\x89T\xC3\x89";
+      tpl = "Le r\xC3\xA9sultat 69 fait ricaner le fond de la classe. Le prof soupire.";
+    } else if (integer && n == 0) {
+      tag = "NUL";
+      tpl = "@I = 0. Le r\xC3\xA9sultat refuse de commenter. Rien \xC3\xA0 dire, litt\xC3\xA9ralement.";
+    } else if (integer && n == 1) {
+      tag = "SOLITUDE";
+      tpl = "@I = 1. Seul, unique, et un peu triste. On pense \xC3\xA0 lui.";
+    } else if (integer && n == 404) {
+      tag = "BUG";
+      mood = 3;
+      tpl = "R\xC3\xA9sultat 404 introuvable. Nos \xC3\xA9quipes le cherchent toujours.";
+    } else if (integer && n == 1337) {
+      tag = "HACKER";
+      mood = 3;
+      tpl = "1337 : un hacker se cache dans la classe. Il porte une capuche.";
+    } else if (integer && n == 7) {
+      tag = "CHANCE";
+      mood = 2;
+      tpl = "7, le chiffre porte-bonheur. Joue au loto. Pas en cours.";
+    } else if (integer && n == 13) {
+      tag = "MAL\xC3\x89\x44ICTION";
+      mood = 1;
+      tpl = "@I = 13. Chiffre maudit. Ne passe pas sous une \xC3\xA9\x63helle aujourd'hui.";
+    } else if (fabs(v - 3.14159265) < 1e-4) {
+      tag = "F\xC3\x8ATE";
+      mood = 2;
+      tpl = "\xCF\x80 aper\xC3\xA7u en pleine classe. Il refuse de s'arr\xC3\xAAter.";
+    } else if (fabs(v) >= 1e9) {
+      tag = "RECORD";
+      mood = 2;
+      tpl = "@O : un nombre si grand qu'il ne tient plus dans le JT.";
+    } else if (v < 0) {
