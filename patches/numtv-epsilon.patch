+void hexBox(Band& b, Rect r, KDColor fill_, KDColor border) {
+  float xs[6] = {static_cast<float>(r.x), r.x + 10.f, r.right() - 10.f,
+                 static_cast<float>(r.right()), r.right() - 10.f, r.x + 10.f};
+  float ys[6] = {r.y + r.h / 2.f, static_cast<float>(r.y),
+                 static_cast<float>(r.y), r.y + r.h / 2.f,
+                 static_cast<float>(r.bottom()), static_cast<float>(r.bottom())};
+  polygon(b, xs, ys, 6, border);
+  for (int i = 0; i < 6; i++) {
+    xs[i] += (xs[i] < r.x + r.w / 2 ? 2 : -2);
+    ys[i] += (ys[i] < r.y + r.h / 2.f ? 2 : (ys[i] > r.y + r.h / 2.f ? -2 : 0));
+  }
+  polygon(b, xs, ys, 6, fill_);
+}
