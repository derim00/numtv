+      tpl = "R\xC3\xA9sultat n\xC3\xA9gatif (@O). Les experts appellent au calme.";
+    } else if (integer && n < 1000000 && isPrime(n)) {
+      tag = "EXCLUSIF";
+      tpl = "@O est premier. Divisible par personne, et tr\xC3\xA8s fier de l'\xC3\xAAtre.";
+    } else if (integer && n > 3 && static_cast<long>(sqrt(static_cast<double>(n))) *
+                                        static_cast<long>(sqrt(static_cast<double>(n))) ==
+                                    n) {
+      tag = "SPORT";
+      tpl = "@O est un carr\xC3\xA9 parfait. Il fait de la muscu tous les matins.";
+    } else if (!integer) {
+      tag = "\xC3\x89\x43ONOMIE";
+      tpl = "@O : un nombre \xC3\xA0 virgule. La virgule r\xC3\xA9\x63lame une augmentation.";
+    } else {
+      static constexpr const char* k_generic[] = {
+          "Le gouvernement confirme : @I fait bien @O.",
+          "@I = @O. Les experts sont formels, la classe est sous le choc.",
+          "@O : le chiffre que personne n'attendait. R\xC3\xA9\x61\x63tions.",
