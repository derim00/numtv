+void drawAnchor(Band& b, float cx, float cy, bool talking, uint32_t now,
+                uint32_t suit, uint32_t hair) {
+  // Shoulders and suit
+  float sx[6] = {cx - 46, cx - 34, cx - 12, cx + 12, cx + 34, cx + 46};
+  float sy[6] = {cy + 90, cy + 46, cy + 36, cy + 36, cy + 46, cy + 90};
+  polygon(b, sx, sy, 6, rgb(suit));
+  float wx[3] = {cx - 12, cx + 12, cx};
+  float wy[3] = {cy + 36, cy + 36, cy + 66};
+  polygon(b, wx, wy, 3, rgb(0xF4F4F4));
+  float tx[4] = {cx - 4, cx + 4, cx + 6, cx - 6};
+  float ty[4] = {cy + 40, cy + 40, cy + 62, cy + 62};
+  polygon(b, tx, ty, 4, rgb(0xD7263D));
+  // Neck, head
+  fill(b, {static_cast<int>(cx) - 7, static_cast<int>(cy) + 22, 14, 16},
+       rgb(0xE0A27C));
+  ellipse(b, cx, cy, 25, 30, rgb(0xF1BE96));
+  ellipse(b, cx - 24, cy + 2, 5, 8, rgb(0xE0A27C));
+  ellipse(b, cx + 24, cy + 2, 5, 8, rgb(0xE0A27C));
+  // Hair (a very serious haircut)
+  ellipse(b, cx, cy - 20, 27, 14, rgb(hair));
+  ellipse(b, cx - 18, cy - 10, 9, 12, rgb(hair));
+  ellipse(b, cx + 20, cy - 12, 8, 10, rgb(hair));
+  // Eyes: they blink
+  bool blink = (now % 3900) < 140;
+  if (blink) {
+    line(b, cx - 13, cy - 2, cx - 5, cy - 2, 2, rgb(0x2A1A10));
+    line(b, cx + 5, cy - 2, cx + 13, cy - 2, 2, rgb(0x2A1A10));
+  } else {
+    ellipse(b, cx - 9, cy - 2, 4.5f, 4.5f, rgb(0xFFFFFF));
+    ellipse(b, cx + 9, cy - 2, 4.5f, 4.5f, rgb(0xFFFFFF));
+    disc(b, static_cast<int>(cx - 8), static_cast<int>(cy - 2), 2,
+         rgb(0x2A1A10));
+    disc(b, static_cast<int>(cx + 10), static_cast<int>(cy - 2), 2,
+         rgb(0x2A1A10));
+  }
+  line(b, cx - 15, cy - 11, cx - 4, cy - 12, 2.5f, rgb(hair));
+  line(b, cx + 4, cy - 12, cx + 15, cy - 10, 2.5f, rgb(hair));
+  // Nose, moustache, mouth
+  line(b, cx, cy, cx + 2, cy + 8, 2, rgb(0xD39A72));
+  ellipse(b, cx - 6, cy + 12, 7, 3, rgb(hair));
+  ellipse(b, cx + 6, cy + 12, 7, 3, rgb(hair));
+  float open = talking ? 1.5f + 3.5f * fabsf(sinf(now * 0.023f)) : 1.f;
+  ellipse(b, cx, cy + 18, 6, open, rgb(0x6A1E1E));
+}
