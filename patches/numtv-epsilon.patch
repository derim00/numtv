+/* Parses a serialized result ("42", "-3.5", "1.2E15") */
+bool parseNumber(const char* t, double* value) {
+  const uint8_t* p = reinterpret_cast<const uint8_t*>(t);
+  bool neg = false;
+  if (*p == '-') {
+    neg = true;
+    p++;
+  } else if (p[0] == 0xE2 && p[1] == 0x88 && p[2] == 0x92) {
+    neg = true;
+    p += 3;
+  }
+  double v = 0;
+  int digits = 0;
+  while ((*p >= '0' && *p <= '9') || *p == ' ' ||
+         (p[0] == 0xE2 && p[1] == 0x80 && p[2] == 0x89)) {
+    if (*p == ' ') {
+      p++;
+      continue;
+    }
+    if (*p == 0xE2) {
+      p += 3;
+      continue;
+    }
+    v = v * 10 + (*p - '0');
+    p++;
+    digits++;
+  }
+  if (*p == '.') {
+    p++;
+    double f = 0.1;
+    while (*p >= '0' && *p <= '9') {
+      v += (*p - '0') * f;
+      f *= 0.1;
+      p++;
+      digits++;
+    }
+  }
+  if (digits == 0) {
+    return false;
+  }
+  if ((p[0] == 0xE1 && p[1] == 0xB4 && p[2] == 0x87) || *p == 'E' ||
+      *p == 'e') {
+    p += (*p == 'E' || *p == 'e') ? 1 : 3;
+    bool eneg = false;
+    if (*p == '-') {
+      eneg = true;
+      p++;
+    } else if (*p == 0xE2) {
+      eneg = true;
+      p += 3;
+    }
+    int e = 0;
+    while (*p >= '0' && *p <= '9') {
+      e = e * 10 + (*p - '0');
+      p++;
+    }
+    for (int i = 0; i < e && i < 400; i++) {
+      v = eneg ? v / 10 : v * 10;
+    }
+  }
+  if (*p != 0) {
+    return false;
+  }
+  *value = neg ? -v : v;
+  return true;
+}
+
+bool contains(const char* text, const char* word) {
+  for (; *text; text++) {
+    const char* a = text;
+    const char* w = word;
+    while (*w && *a == *w) {
+      a++;
+      w++;
+    }
+    if (*w == 0) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool isPrime(long n) {
+  if (n < 2) {
+    return false;
+  }
+  for (long d = 2; d * d <= n; d++) {
+    if (n % d == 0) {
+      return false;
+    }
+  }
+  return true;
+}
+
+/* Replaces "@I" by the input, "@O" by the output */
+void fillTemplate(char* out, int size, const char* tpl, const char* in,
+                  const char* res) {
+  Str m(out, size);
+  for (const char* p = tpl; *p; p++) {
+    if (p[0] == '@' && p[1] == 'I') {
+      m.add(in);
+      p++;
+    } else if (p[0] == '@' && p[1] == 'O') {
+      m.add(res);
+      p++;
+    } else {
+      char c[2] = {*p, 0};
+      m.add(c);
+    }
+  }
+}
