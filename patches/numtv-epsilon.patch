+void weatherIcon(Band& b, int kind, float x, float y, uint32_t now) {
+  float t = now * 0.001f;
+  switch (kind) {
+    case 0: {  // sun
+      for (int i = 0; i < 8; i++) {
+        float a = i * k_pi / 4 + t * 0.6f;
+        line(b, x + cosf(a) * 11, y + sinf(a) * 11, x + cosf(a) * 16,
+             y + sinf(a) * 16, 2.5f, rgb(0xFFD23A));
+      }
+      ellipse(b, x, y, 9, 9, rgb(0xFFC21A));
+      break;
+    }
+    case 1:  // clouds
+      cloud(b, x, y, 1.f, rgb(0xE8EEF6));
+      break;
+    case 2:  // rain
+    case 6: {  // a rain of exam papers
+      cloud(b, x, y - 3, 1.f, rgb(0xB8C4D6));
+      for (int i = 0; i < 4; i++) {
+        float py = y + 8 + fmodf(t * 30 + i * 7, 14);
+        float px = x - 9 + i * 6;
+        if (kind == 2) {
+          line(b, px, py, px - 2, py + 4, 1.5f, rgb(0x4DA3FF));
+        } else {
+          fill(b, {static_cast<int>(px), static_cast<int>(py), 5, 6},
+               rgb(0xFFFFFF));
+        }
+      }
+      break;
+    }
+    case 3: {  // storm
+      cloud(b, x, y - 3, 1.f, rgb(0x7C8699));
+      float lx[6] = {x - 1, x + 5, x + 1, x + 4, x - 4, x - 1};
+      float ly[6] = {y + 4, y + 4, y + 10, y + 10, y + 20, y + 11};
+      if ((now / 300) % 3 != 0) {
+        polygon(b, lx, ly, 6, rgb(0xFFE14D));
+      }
+      break;
+    }
+    case 4: {  // snow
+      cloud(b, x, y - 3, 1.f, rgb(0xFFFFFF));
+      for (int i = 0; i < 4; i++) {
+        float py = y + 8 + fmodf(t * 10 + i * 5, 12);
+        disc(b, static_cast<int>(x - 9 + i * 6), static_cast<int>(py), 1,
+             rgb(0xFFFFFF));
+      }
+      break;
+    }
+    case 5:  // fog
+      for (int i = 0; i < 3; i++) {
+        float o = sinf(t + i) * 3;
+        line(b, x - 12 + o, y - 5 + i * 6, x + 12 + o, y - 5 + i * 6, 3,
+             rgb(0xD0D6E0));
+      }
+      break;
+    default: {  // tornado of homework
+      for (int i = 0; i < 5; i++) {
+        float w = 12 - i * 2.2f;
+        float o = sinf(t * 4 + i) * 3;
+        ellipse(b, x + o, y - 8 + i * 5, w, 2.5f, rgb(0xC8C0B0));
+      }
+      break;
+    }
+  }
+}
