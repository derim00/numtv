+void Channels::renderApp(int index, Band& b) {
+  const AppSlot& a = s_apps[index];
+  bool game = a.item.kind == Item::Kind::External;
+  int hue = a.show ? a.show->hue : (game ? 350 : 200);
+  KDColor top = hue < 0 ? rgb(0x40444E) : hsv(hue, 200, 120);
+  KDColor bottom = hue < 0 ? rgb(0x101216) : hsv(hue, 230, 30);
+  for (int y = b.clip().y; y < b.clip().bottom(); y++) {
+    KDColor c = mix(top, bottom, y * 256 / 240);
+    KDColor* row = b.row(y);
+    for (int x = 0; x < k_screenWidth; x++) {
+      row[x] = c;
