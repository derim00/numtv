+void renderStatic(Band& b, int strength) {
+  const Rect& c = b.clip();
+  uint32_t seed = s.now / 33;
+  int barY = static_cast<int>((s.now / 3) % 300) - 30;
+  for (int y = c.y; y < c.bottom(); y++) {
+    KDColor* row = b.row(y);
+    int bright = (y > barY && y < barY + 26) ? 60 : 0;
+    uint32_t h = hash(seed * 2654435761u + y * 97u);
+    for (int x = c.x; x < c.right(); x++) {
+      h ^= h << 13;
+      h ^= h >> 17;
+      h ^= h << 5;
+      int v = (h & 0xFF) * strength / 256 + bright;
+      v = v > 255 ? 255 : v;
+      row[x] = KDColor::RGB888(v, v, v + (v >> 3) > 255 ? 255 : v + (v >> 3));
+    }
+  }
+}
