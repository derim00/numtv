+
+uint16_t Channels::ledColor(int channel, int* k) {
+  uint32_t now = s.now;
+  KDColor c = KDBlack;
+  *k = 0;
+  switch (channel) {
+    case ChNews:
+      c = rgb(0xFF0000);
+      *k = 50 + static_cast<int>(40 * sinf(now * 0.004f));
+      if (now < s.flashSpecialUntil) {
+        *k = (now / 120) % 2 ? 255 : 0;
+      }
+      break;
+    case ChWeather:
+      c = rgb(0x3AA0FF);
+      *k = 40;
+      break;
+    case ChShop:
+      c = hsv((now / 4) % 360, 255, 255);
+      *k = 110;
+      break;
+    case ChWheel:
+      if (now < s_tickUntil) {
+        c = rgb(0xFFFFFF);
+        *k = 255;
+      } else if (s.wheelResult >= 0 && now - s.wheelResultStart < 3000) {
+        c = hsv((now / 3) % 360, 255, 255);
+        *k = 200;
+      } else {
+        c = rgb(0xA040FF);
+        *k = 30;
+      }
+      break;
+    case ChDetector:
+      if (s.scanning) {
+        c = rgb(0xFF2020);
+        uint32_t beat = (now - s.scanStart) % 500;
+        *k = beat < 90 ? 255 : 30;
+      } else if (s.verdict >= 0 && now - s.verdictStart < 6000) {
+        c = s.verdict == 0 ? rgb(0x00FF40) : (s.verdict == 1 ? rgb(0xFF0000) : rgb(0xFF9000));
+        *k = (now / 150) % 2 ? 255 : 60;
+      } else {
+        c = rgb(0x1DE9B6);
+        *k = 20;
+      }
+      break;
+    case ChExcuse:
+      c = rgb(0xFFB000);
+      *k = now < s.reelStop[3] ? ((now / 90) % 2 ? 220 : 40) : 20;
+      break;
+    case ChQuiz:
+      if (s.quiz == QuizPhase::Suspense) {
+        c = rgb(0xFF8000);
+        *k = 60 + static_cast<int>(120 * fabsf(sinf(now * 0.01f)));
+      } else if (s.quiz == QuizPhase::Reveal) {
+        c = s.qSelected == s.qCorrect ? rgb(0x00FF40) : rgb(0xFF0000);
+        *k = 220;
+      } else {
+        c = rgb(0x5040FF);
+        *k = 25;
+      }
+      break;
+    case ChFire:
+      c = s.fuel == 2 ? rgb(0x30FF40) : (s.fuel == 1 ? rgb(0x80A0FF) : (s.fuel == 3 ? hsv((now / 4) % 360, 255, 255) : rgb(0xFF5000)));
+      *k = 60 + static_cast<int>(hash(now / 70) % 150);
+      break;
+    case ChSaver:
+      if (now < s.cornerUntil) {
+        c = hsv((now / 2) % 360, 255, 255);
+        *k = 255;
+      } else {
+        c = hsv(s.saverHue, 255, 255);
+        *k = 35;
+      }
+      break;
+    default:
+      break;
+  }
+  return static_cast<uint16_t>(c);
+}
+
+}  // namespace Tv
+}  // namespace Home
diff --git a/epsilon/apps/home/tv/food.cpp b/epsilon/apps/home/tv/food.cpp
new file mode 100644
index 0000000000..41fa765068
--- /dev/null
+++ b/epsilon/apps/home/tv/food.cpp
@@ -0,0 +1,55 @@
+#include "food.h"
+
+#include <string.h>
+
+namespace Home {
+namespace Tv {
+namespace Food {
+
+namespace {
+Entry s_ring[k_ringSize];
+uint32_t s_produced = 0;
+
+void copy(char* dst, const char* src) {
+  int n = 0;
+  if (src) {
+    while (src[n] && n < k_textSize - 1) {
+      dst[n] = src[n];
+      n++;
+    }
+    if (src[n] != 0) {
+      // Cut: never cut a UTF-8 character in two
+      while (n > 0 && (static_cast<uint8_t>(dst[n - 1]) & 0xC0) == 0x80) {
+        n--;
+      }
+      if (n > 0 && (static_cast<uint8_t>(dst[n - 1]) & 0xC0) == 0xC0) {
+        n--;
+      }
+    }
+  }
+  dst[n] = 0;
+}
+}  // namespace
+
+void push(const char* input, const char* output) {
+  if (output == nullptr || output[0] == 0) {
+    return;
+  }
+  Entry& e = s_ring[s_produced % k_ringSize];
+  copy(e.input, input);
+  copy(e.output, output);
+  s_produced++;
+}
+
+uint32_t produced() { return s_produced; }
+
+const Entry* at(uint32_t index) {
+  if (index >= s_produced || s_produced - index > k_ringSize) {
+    return nullptr;
+  }
+  return &s_ring[index % k_ringSize];
+}
+
+}  // namespace Food
+}  // namespace Tv
+}  // namespace Home
