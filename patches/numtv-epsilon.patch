+namespace {
+
+void updateParticles(float dt) {
+  int ms = static_cast<int>(dt * 1000);
+  for (Particle& p : s.particles) {
+    if (p.life == 0) {
+      continue;
+    }
+    p.life = p.life > ms ? p.life - ms : 0;
+    p.vy += 380 * dt;
+    p.vx *= 0.985f;
+    p.x += p.vx * dt;
+    p.y += p.vy * dt;
+  }
+}
+
+void drawParticles(Band& b) {
+  for (const Particle& p : s.particles) {
+    if (p.life == 0) {
+      continue;
+    }
+    int a = p.life < 300 ? p.life * 256 / 300 : 256;
+    int w = p.size + ((static_cast<int>(p.x) / 7) % 2);
+    fill(b, {static_cast<int>(p.x), static_cast<int>(p.y), w, p.size},
+         KDColor::RGB16(p.rgb565), a);
+  }
+}
