+constexpr int k_saverW = 120, k_saverH = 44;
+
+void renderSaver(Band& b) {
+  fill(b, k_screen, rgb(0x000000));
+  KDColor c = hsv(s.saverHue, 220, 255);
+  int x = static_cast<int>(s.saverX), y = static_cast<int>(s.saverY);
+  ellipse(b, x + k_saverW / 2.f, y + 34, 54, 9, c);
+  ellipse(b, x + k_saverW / 2.f, y + 34, 22, 4, rgb(0x000000));
+  bigText(b, "NUM TV", x + k_saverW / 2, y, 2, c, Align::Center);
+  char line[30];
+  Str m(line, sizeof(line));
+  m.add("coins touch\xC3\xA9s : ").addInt(s.corners);
+  text(b, line, 14, 222, rgb(0x404040), Small);
+  if (s.now - s.channelStart < 4000) {
+    text(b, "Il va toucher le coin. Un jour.", 160, 200, rgb(0x707070), Small,
+         Align::Center);
+  }
+  if (s.now < s.cornerUntil) {
+    bool on = (s.now / 120) % 2;
+    bigShadow(b, "COIN !!!", 160, 96, 3, on ? rgb(0xFFFFFF) : c);
+  }
+}
+
+void updateSaver(float dt) {
+  float speed = 62.f;
+  s.saverX += s.saverDX / 2 * speed * dt;
+  s.saverY += s.saverDY / 2 * speed * dt;
+  bool bx = false, by = false;
+  float maxX = k_screenWidth - k_saverW, maxY = k_screenHeight - k_saverH;
+  if (s.saverX <= 0) {
+    s.saverX = 0;
+    s.saverDX = 2;
+    bx = true;
+  } else if (s.saverX >= maxX) {
+    s.saverX = maxX;
+    s.saverDX = -2;
+    bx = true;
+  }
+  if (s.saverY <= 0) {
+    s.saverY = 0;
+    s.saverDY = 2;
+    by = true;
+  } else if (s.saverY >= maxY) {
+    s.saverY = maxY;
+    s.saverDY = -2;
+    by = true;
+  }
+  if (bx || by) {
+    s.saverHue = (s.saverHue + 70 + rnd() % 80) % 360;
+    // A corner: both walls at (almost) the same time
+    bool nearX = s.saverX < 3 || s.saverX > maxX - 3;
+    bool nearY = s.saverY < 3 || s.saverY > maxY - 3;
+    if (nearX && nearY && s.now > s.cornerUntil + 1000) {
+      s.corners++;
+      s.cornerUntil = s.now + 3500;
+      burst(s.saverX + k_saverW / 2, s.saverY + k_saverH / 2, 56, -1);
+      flash(300);
+    }
+  }
+}
