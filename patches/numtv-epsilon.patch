+bool Channels::capturesDigits(int channel) {
+  return channel == ChQuiz && s.quiz != QuizPhase::Intro &&
+         s.quiz != QuizPhase::Over;
+}
+
+bool Channels::handleEvent(int channel, Event e) {
+  bool ok = e == Events::OK || e == Events::EXE;
+  switch (channel) {
+    case ChNews: {
+      int n = playlistLength();
+      if (e == Events::Right || ok) {
+        s.storyShown = (s.storyShown + 1) % n;
+        s.storyStart = s.now;
+        return true;
+      }
+      if (e == Events::Left) {
+        s.storyShown = (s.storyShown + n - 1) % n;
+        s.storyStart = s.now;
+        return true;
+      }
+      return false;
+    }
+    case ChWeather:
+      if (e == Events::Right || ok) {
+        s.weatherDay = (s.weatherDay + 1) % 5;
+        return true;
+      }
+      if (e == Events::Left) {
+        s.weatherDay = (s.weatherDay + 4) % 5;
+        return true;
+      }
+      return false;
+    case ChShop:
+      if (e == Events::Right || e == Events::Left) {
+        int n = count(k_products);
+        s.product = (s.product + (e == Events::Right ? 1 : n - 1)) % n;
+        s.productStart = s.now;
+        s.orderStart = 0;
+        return true;
+      }
+      if (ok) {
+        s.orderStart = s.now;
+        s.orderAnswer = rnd() % count(k_orders);
+        flash(80);
+        return true;
+      }
+      return false;
+    case ChWheel:
+      if (s.wheelSpinning) {
+        return e == Events::Left || e == Events::Right || ok;
+      }
+      if (e == Events::Right || e == Events::Left) {
+        int v = s.wheelCount + (e == Events::Right ? 1 : -1);
+        s.wheelCount = v > 41 ? 2 : (v < 2 ? 41 : v);
+        s.wheelResult = -1;
+        return true;
+      }
+      if (ok) {
+        s.wheelSpinning = true;
+        s.wheelSpeed = 9.f + frnd() * 6.f;
+        s.wheelResult = -1;
+        s.wheelLastSlice = -1;
+        s.spins++;
+        return true;
+      }
+      return false;
+    case ChDetector:
+      if (s.scanning) {
+        return true;
+      }
+      if (e == Events::Left) {
+        s.rig = s.rig == 0 ? -1 : 0;
+        return true;
+      }
+      if (e == Events::Right) {
+        s.rig = s.rig == 1 ? -1 : 1;
+        return true;
+      }
+      if (ok) {
+        s.scanning = true;
+        s.scanStart = s.now;
+        s.verdict = -1;
+        return true;
+      }
+      return false;
+    case ChExcuse:
+      if (ok) {
+        if (s.now < s.reelStop[3]) {
+          return true;
+        }
+        s.leverStart = s.now;
+        s.excuseReady = false;
+        for (int i = 0; i < 4; i++) {
+          s.reel[i] = rnd() % k_reelSizes[i];
+          s.reelStop[i] = s.now + 700 + i * 550;
+        }
+        return true;
+      }
+      return false;
+    case ChQuiz:
+      return quizEvent(e);
+    case ChFire:
+      if (e == Events::Right || e == Events::Left) {
+        s.fuel = (s.fuel + (e == Events::Right ? 1 : 3)) % 4;
+        return true;
+      }
+      return false;
+    default:
+      return false;
+  }
+}
+
+void Channels::update(int channel, float dt) {
+  switch (channel) {
+    case ChNews:
+      if (s.now - s.storyStart > k_storyDuration && s.now > s.flashSpecialUntil) {
+        s.storyShown = (s.storyShown + 1) % playlistLength();
+        s.storyStart = s.now;
+      }
+      break;
+    case ChWheel:
+      updateWheel(dt);
+      break;
+    case ChDetector:
+      updateDetector();
+      break;
+    case ChExcuse:
+      updateExcuse();
+      break;
+    case ChQuiz:
+      updateQuiz();
+      break;
+    case ChFire:
+      updateFire();
+      break;
+    case ChSaver:
+      updateSaver(dt);
+      break;
+    default:
+      break;
+  }
+}
