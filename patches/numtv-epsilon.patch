+void updateQuiz() {
+  uint32_t t = s.now - s.quizStart;
+  if (s.quiz == QuizPhase::Suspense && t > 1700) {
+    s.quiz = QuizPhase::Reveal;
+    s.quizStart = s.now;
+    if (s.qSelected == s.qCorrect) {
+      s.quizScore = k_ladder[s.qLevel];
+      burst(160, 140, 30, 120);
+      flash(120);
+    }
+  } else if (s.quiz == QuizPhase::Reveal && t > 1900) {
+    if (s.qSelected == s.qCorrect) {
+      s.qLevel++;
+      if (s.qLevel >= 10) {
+        s.quiz = QuizPhase::Over;
+        burst(160, 100, 56, -1);
+      } else {
+        s.quiz = QuizPhase::Question;
+        s.quizStart = s.now;
+        makeQuestion();
+      }
+    } else {
+      // Back to the last safe step
+      s.quizScore = s.qLevel >= 5 ? k_ladder[4] : 0;
+      s.quiz = QuizPhase::Over;
+    }
+    if (s.quiz == QuizPhase::Over && s.quizScore > s.quizBest) {
+      s.quizBest = s.quizScore;
+    }
+  }
+}
+
+bool quizEvent(Event e) {
+  switch (s.quiz) {
+    case QuizPhase::Intro:
+    case QuizPhase::Over:
+      if (e == Events::OK || e == Events::EXE) {
+        quizStart();
+        return true;
+      }
+      return false;
+    case QuizPhase::Question: {
+      int sel = s.qSelected;
+      for (int tries = 0; tries < 4; tries++) {
+        if (e == Events::Left || e == Events::Right) {
+          sel ^= 1;
+        } else if (e == Events::Up || e == Events::Down) {
+          sel ^= 2;
+        } else {
+          break;
+        }
+        if (!(s.qHidden & (1 << sel))) {
+          break;
+        }
+      }
+      if (e == Events::Left || e == Events::Right || e == Events::Up ||
+          e == Events::Down) {
+        if (!(s.qHidden & (1 << sel))) {
+          s.qSelected = sel;
+        }
+        return true;
+      }
+      if (e == Events::OK || e == Events::EXE) {
+        if (!(s.qHidden & (1 << s.qSelected))) {
+          s.quiz = QuizPhase::Confirm;
+          s.quizStart = s.now;
+        }
+        return true;
+      }
+      if (e == Events::One && !s.joker5050) {
+        s.joker5050 = true;
+        int removed = 0;
+        int guard = 0;
+        while (removed < 2 && guard++ < 50) {
+          int i = rnd() % 4;
+          if (i != s.qCorrect && !(s.qHidden & (1 << i))) {
+            s.qHidden |= 1 << i;
+            removed++;
+          }
+        }
+        if (s.qHidden & (1 << s.qSelected)) {
+          s.qSelected = s.qCorrect;
+        }
+        return true;
+      }
+      if (e == Events::Two && !s.jokerPublic) {
+        s.jokerPublic = true;
+        int left = 100;
+        int main = (s.qLevel == 4 || s.qLevel == 9) ? 15 + rnd() % 20
+                                                     : 45 + rnd() % 30;
+        s.publicBars[s.qCorrect] = main;
+        left -= main;
+        for (int i = 0; i < 4; i++) {
+          if (i == s.qCorrect) {
+            continue;
+          }
+          int v = (s.qHidden & (1 << i)) ? 0 : static_cast<int>(rnd() % (left + 1));
+          s.publicBars[i] = v;
+          left -= v;
+        }
+        // The rest goes to the most wrong answer (the public is like that)
+        for (int i = 3; i >= 0; i--) {
+          if (i != s.qCorrect && !(s.qHidden & (1 << i))) {
+            s.publicBars[i] += left;
+            break;
+          }
+        }
+        s.publicUntil = s.now + 4000;
+        return true;
+      }
+      if (e == Events::Three && !s.jokerFriend) {
+        s.jokerFriend = true;
+        s.friendLine = rnd() & 0xFFFF;
+        s.friendUntil = s.now + 4500;
+        return true;
+      }
+      return false;
+    }
+    case QuizPhase::Confirm:
+      if (e == Events::OK || e == Events::EXE) {
+        s.quiz = QuizPhase::Suspense;
+        s.quizStart = s.now;
+      } else if (e == Events::Left || e == Events::Right || e == Events::Up ||
+                 e == Events::Down) {
+        s.quiz = QuizPhase::Question;
+        return quizEvent(e);
+      }
+      return true;
+    default:
+      return true;
+  }
+}
