+          "@I donne @O. Le r\xC3\xA9sultat sera reconduit \xC3\xA0 la fronti\xC3\xA8re de la copie.",
+      };
+      tag = "BREAKING";
+      tpl = k_generic[rnd() % count(k_generic)];
+    }
+  } else {
+    tag = "INSOLITE";
+    mood = 3;
+    tpl = "Un r\xC3\xA9sultat \xC3\xA9trange (@O) aper\xC3\xA7u apr\xC3\xA8s @I. Il ne vient pas d'ici.";
+  }
+  fillTemplate(textBuf, sizeof(textBuf), tpl, in, out);
+  Channels::addStory(tag, textBuf, inset, mood);
+}
