+
+float normAngle(float a) {
+  float t = fmodf(a, 2 * k_pi);
+  return t < 0 ? t + 2 * k_pi : t;
+}
+
+int sliceAt(float screenAngle) {
+  int n = wheelSlices();
+  int i = static_cast<int>(normAngle(screenAngle - s.wheelAngle) /
+                           (2 * k_pi / n));
+  return i >= n ? n - 1 : i;
+}
+
+float fastAtan2(float y, float x) {
+  float ax = fabsf(x), ay = fabsf(y);
+  float mn = ax < ay ? ax : ay, mx = ax < ay ? ay : ax;
+  if (mx == 0) {
+    return 0;
+  }
+  float a = mn / mx;
+  float sq = a * a;
+  float r = ((-0.0464964749f * sq + 0.15931422f) * sq - 0.327622764f) * sq * a + a;
+  if (ay > ax) {
+    r = 1.57079637f - r;
+  }
+  if (x < 0) {
+    r = 3.14159274f - r;
+  }
+  if (y < 0) {
+    r = -r;
+  }
+  return r;
+}
+
+void renderWheel(Band& b) {
+  gradient(b, 0x3B0A5C, 0x12021F);
+  // Spotlights
+  for (int i = 0; i < 4; i++) {
+    float a = sinf(s.now * 0.0009f + i * 1.7f) * 0.5f;
+    float bx = 40 + i * 80;
+    float xs[3] = {bx, bx + 260 * sinf(a) - 30, bx + 260 * sinf(a) + 30};
+    float ys[3] = {0, 240, 240};
+    polygon(b, xs, ys, 3, rgb(0xFFF2B0), 26);
+  }
+  bool dares = s.wheelCount > 40;
+  text(b, dares ? "LA ROUE DES GAGES" : "QUI PASSE AU TABLEAU ?", 188, 6,
+       rgb(0xFFD23A), Large, Align::Center);
+  channelBug(b, "NUM 4", 0xFFD23A);
+  constexpr int cx = 160, cy = 128;
+  constexpr int R = 84;
+  int n = wheelSlices();
+  float sliceA = 2 * k_pi / n;
+  int lo = b.clip().y > cy - R - 6 ? b.clip().y : cy - R - 6;
+  int hi = b.clip().bottom() < cy + R + 6 ? b.clip().bottom() : cy + R + 6;
+  for (int y = lo; y < hi; y++) {
+    KDColor* row = b.row(y);
+    float dy = y + 0.5f - cy;
+    for (int x = cx - R - 6; x < cx + R + 6; x++) {
+      float dx = x + 0.5f - cx;
+      float d2 = dx * dx + dy * dy;
+      if (d2 > (R + 5.5f) * (R + 5.5f)) {
+        continue;
+      }
+      if (d2 > R * R) {
+        row[x] = rgb(0xE8B020);
+        continue;
+      }
+      if (d2 < 15 * 15) {
+        row[x] = d2 < 11 * 11 ? rgb(0xFFF2D0) : rgb(0xE8B020);
+        continue;
+      }
+      float rel = normAngle(fastAtan2(dy, dx) - s.wheelAngle);
+      int i = static_cast<int>(rel / sliceA);
+      float edge = rel - i * sliceA;
+      if (edge < 0.012f * (R * R) / (d2 > 1 ? sqrtf(d2) * R : 1)) {
+        row[x] = rgb(0xFFFFFF);
+        continue;
+      }
+      int hue = dares ? (i * 45) % 360 : (i * 360 / n * 7) % 360;
+      row[x] = hsv(hue, i % 2 ? 210 : 170, i % 2 ? 235 : 255);
+    }
+  }
+  // Bulbs on the rim
+  for (int i = 0; i < 16; i++) {
+    float a = i * k_pi / 8;
+    bool on = ((s.now / 150) + i) % 2;
+    disc(b, static_cast<int>(cx + cosf(a) * (R + 3)),
+         static_cast<int>(cy + sinf(a) * (R + 3)), 2,
+         on ? rgb(0xFFFFFF) : rgb(0x8A5A00));
+  }
+  // Labels
+  if (n <= 24) {
+    for (int i = 0; i < n; i++) {
+      float a = s.wheelAngle + (i + 0.5f) * sliceA;
+      float r = n > 14 ? R - 13 : R - 22;
+      char lb[4];
+      Str m(lb, sizeof(lb));
+      m.addInt(i + 1);
+      text(b, lb, static_cast<int>(cx + cosf(a) * r),
+           static_cast<int>(cy + sinf(a) * r) - 7, rgb(0x1A0033), Small,
+           Align::Center);
+    }
+  }
+  // The pointer
+  float px[3] = {cx - 10, cx + 10, cx};
+  float py[3] = {cy - R - 14, cy - R - 14, cy - R + 8};
+  bool tick = s.now < s_tickUntil;
+  if (tick) {
+    px[2] += 4;
+  }
+  polygon(b, px, py, 3, rgb(0xFFFFFF));
+  // Under the wheel
+  char line1[40];
+  Str m(line1, sizeof(line1));
+  if (dares) {
+    m.add("< ROUE DES GAGES >");
+  } else {
+    m.add("< ").addInt(s.wheelCount).add(" \xC3\xA9l\xC3\xA8ves >");
+  }
+  fill(b, {0, 218, k_screenWidth, 22}, rgb(0x000000), 150);
+  text(b, line1, 80, 222, rgb(0xFFFFFF), Small, Align::Center);
+  text(b, s.wheelSpinning ? "..." : "OK : TOURNER", 240, 222, rgb(0xFFD23A),
+       Small, Align::Center);
+  // The verdict
+  if (s.wheelResult >= 0 && !s.wheelSpinning) {
+    uint32_t t = s.now - s.wheelResultStart;
+    float k = t < 300 ? t / 300.f : 1.f;
+    int h = static_cast<int>(70 * k);
+    Rect box = {20, 128 - h / 2, 280, h};
+    roundFill(b, box, 8, rgb(0x000000), 220);
+    roundFrame(b, box, 8, rgb(0xFFD23A));
+    if (k >= 1.f) {
+      if (dares) {
+        char num[16];
+        Str nm(num, sizeof(num));
+        nm.add("GAGE N\xC2\xB0").addInt(s.wheelResult + 1);
+        text(b, num, 160, 98, rgb(0xFFD23A), Small, Align::Center);
+        wrapped(b, k_dares[s.wheelResult], 28, 116, 264, rgb(0xFFFFFF), Large,
+                19, Align::Center, 2);
+      } else {
+        char num[24];
+        Str nm(num, sizeof(num));
+        nm.add("N\xC2\xB0 ").addInt(s.wheelResult + 1);
+        bigShadow(b, num, 160, 98, 2, rgb(0xFFD23A));
+        static constexpr const char* k_lines[] = {
+            "AU TABLEAU ! Le destin a parl\xC3\xA9.",
+            "AU TABLEAU ! Courage, on pense \xC3\xA0 toi.",
+            "AU TABLEAU ! Pas de r\xC3\xA9\x63lamation.",
+            "AU TABLEAU ! La roue ne se trompe jamais.",
+        };
+        text(b, k_lines[s.wheelResult % 4], 160, 138, rgb(0xFFFFFF), Small,
+             Align::Center);
+      }
+    }
+  }
+}
+
+void updateWheel(float dt) {
+  if (!s.wheelSpinning) {
+    return;
+  }
+  s.wheelAngle += s.wheelSpeed * dt;
+  s.wheelSpeed -= (0.55f + s.wheelSpeed * 0.32f) * dt;
+  int slice = sliceAt(-k_pi / 2);
+  if (slice != s.wheelLastSlice) {
+    s.wheelLastSlice = slice;
+    s_tickUntil = s.now + 60;
+  }
+  if (s.wheelSpeed <= 0.02f) {
+    s.wheelSpeed = 0;
+    s.wheelSpinning = false;
+    s.wheelResult = slice;
+    s.wheelResultStart = s.now;
+    burst(160, 120, 40, -1);
+    flash(150);
+  }
+}
