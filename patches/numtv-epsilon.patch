+#include <string.h>
+
+#include "tv.h"
+
+/* What is on NUM TV tonight. */
+
+namespace Home {
+namespace Tv {
+
+namespace {
+
+namespace Events = Ion::Events;
+using Ion::Events::Event;
+using Ion::Keyboard::Key;
+using KDFont::Size::Large;
+using KDFont::Size::Small;
+
+constexpr float k_pi = 3.14159265f;
+
+template <typename T, int N>
+constexpr int count(T (&)[N]) {
+  return N;
+}
+
+uint32_t s_tickUntil = 0;
+
+/* ============================================================== helpers */
+
+void gradient(Band& b, uint32_t top, uint32_t bottom, int y0 = 0,
+              int y1 = k_screenHeight) {
+  KDColor a = rgb(top), z = rgb(bottom);
+  int lo = b.clip().y > y0 ? b.clip().y : y0;
+  int hi = b.clip().bottom() < y1 ? b.clip().bottom() : y1;
+  for (int y = lo; y < hi; y++) {
+    KDColor c = mix(a, z, (y - y0) * 256 / (y1 - y0));
+    KDColor* row = b.row(y);
+    for (int x = b.clip().x; x < b.clip().right(); x++) {
+      row[x] = c;
+    }
+  }
+}
+
+void shadowText(Band& b, const char* s, int x, int y, KDColor c,
+                KDFont::Size font = Small, Align align = Align::Left) {
+  text(b, s, x + 1, y + 1, rgb(0x000000), font, align, k_screenWidth, 160);
+  text(b, s, x, y, c, font, align);
+}
+
+void bigShadow(Band& b, const char* s, int x, int y, int scale, KDColor c,
+               Align align = Align::Center) {
+  bigText(b, s, x + scale, y + scale, scale, rgb(0x000000), align, 170);
+  bigText(b, s, x, y, scale, c, align);
+}
+
+void star(Band& b, float cx, float cy, float r, float inner, int points,
+          float rot, KDColor c, int alpha = 256) {
+  float xs[40], ys[40];
+  int n = points * 2;
+  for (int i = 0; i < n; i++) {
+    float a = rot + i * k_pi / points;
+    float rr = i % 2 ? r * inner : r;
+    xs[i] = cx + cosf(a) * rr;
+    ys[i] = cy + sinf(a) * rr;
+  }
+  polygon(b, xs, ys, n, c, alpha);
+}
