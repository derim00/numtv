+void Channels::renderAd(Band& b, int ad, uint32_t t) {
+  const Ad& a = k_ads[ad % count(k_ads)];
+  gradient(b, a.a, a.z);
+  // Sun rays behind the brand
+  for (int i = 0; i < 12; i++) {
+    float ang = i * k_pi / 6 + t * 0.0006f;
+    float xs[3] = {160, 160 + cosf(ang) * 300, 160 + cosf(ang + 0.2f) * 300};
+    float ys[3] = {96, 96 + sinf(ang) * 300, 96 + sinf(ang + 0.2f) * 300};
+    polygon(b, xs, ys, 3, rgb(0xFFFFFF), 30);
+  }
+  float k = t < 500 ? t / 500.f : 1.f;
+  float bounce = t < 500 ? 0 : sinf(t * 0.006f) * 3;
+  int scale = k < 0.4f ? 1 : (k < 0.8f ? 2 : 3);
+  if (textWidth(a.brand, Large) * scale > 300) {
+    scale = 2;
+  }
+  bool dark = ((a.a >> 16) + ((a.a >> 8) & 0xFF) + (a.a & 0xFF)) > 600;
+  KDColor fg = dark ? rgb(0x101010) : rgb(0xFFFFFF);
+  bigShadow(b, a.brand, 160, static_cast<int>(52 + bounce), scale, fg);
+  for (int i = 0; i < 3; i++) {
+    float sa = t * 0.003f + i * 2.1f;
+    star(b, 160 + cosf(sa) * 120, 94 + sinf(sa) * 40, 7, 0.3f, 4, sa,
+         rgb(0xFFFFFF), 220);
+  }
+  if (t > 600) {
+    roundFill(b, {14, 116, 292, 52}, 8, rgb(0x000000), 120);
+    wrapped(b, a.slogan, 22, 120, 276, rgb(0xFFFFFF), Small, 15, Align::Center,
+            3);
+  }
+  text(b, a.legal, 160, 174, fg, Small, Align::Center, 300, 200);
+  text(b, "Pour votre sant\xC3\xA9, r\xC3\xA9visez au moins 5 fois par jour.", 160,
+       190, fg, Small, Align::Center, 300, 150);
+}
