+  int l = s.qLevel;
+  s.qHidden = 0;
+  s.publicUntil = 0;
+  s.friendUntil = 0;
+  s.qSelected = 0;
+  if (l == 4 || l == 9) {
+    const Joke& j = k_jokes[rnd() % count(k_jokes)];
+    strlcpy(s.qText, j.q, sizeof(s.qText));
+    for (int i = 0; i < 4; i++) {
+      strlcpy(s.qAnswers[i], j.a[i], sizeof(s.qAnswers[i]));
+    }
+    s.qCorrect = j.correct;
+    return;
+  }
+  long a, b2, r;
+  Str q(s.qText, sizeof(s.qText));
+  switch (l) {
+    case 0:
+    case 1:
+      a = 12 + rnd() % 60;
+      b2 = 11 + rnd() % 60;
+      r = a + b2;
+      q.add("Combien font ").addInt(a).add(" + ").addInt(b2).add(" ?");
+      break;
+    case 2:
+    case 3:
+      a = 3 + rnd() % 7;
+      b2 = 12 + rnd() % 30;
+      r = a * b2;
+      q.add("Combien font ").addInt(a).add(" \xC3\x97 ").addInt(b2).add(" ?");
+      break;
+    case 5:
+      a = 11 + rnd() % 15;
+      r = a * a;
+      q.add("Combien font ").addInt(a).add(" au carr\xC3\xA9 ?");
+      break;
+    case 6: {
+      static constexpr int k_pc[] = {10, 20, 25, 50, 75};
+      a = k_pc[rnd() % 5];
+      b2 = (2 + rnd() % 18) * 20;
+      r = a * b2 / 100;
+      q.add("Combien font ").addInt(a).add(" % de ").addInt(b2).add(" ?");
+      break;
+    }
+    case 7:
+      a = 6 + rnd() % 7;
+      r = 1L << a;
+      q.add("Combien font 2 puissance ").addInt(a).add(" ?");
+      break;
+    default:
+      a = 13 + rnd() % 17;
+      r = a;
+      q.add("Racine carr\xC3\xA9\x65 de ").addInt(a * a).add(" ?");
+      break;
+  }
+  long options[4];
+  s.qCorrect = rnd() % 4;
+  static constexpr long k_deltas[] = {1, -1, 2, -2, 10, -10, 11, 9, -9, 20};
+  for (int i = 0; i < 4; i++) {
+    if (i == s.qCorrect) {
+      options[i] = r;
+      continue;
+    }
+    long v;
+    bool ok;
+    int guard = 0;
+    do {
+      v = r + k_deltas[rnd() % count(k_deltas)];
+      ok = v >= 0 && v != r;
+      for (int j = 0; j < i; j++) {
+        if (options[j] == v) {
+          ok = false;
+        }
+      }
+      if (s.qCorrect < i && v == r) {
+        ok = false;
+      }
+      guard++;
+    } while (!ok && guard < 40);
+    if (!ok) {
+      v = r + 100 + i;
+    }
+    options[i] = v;
+  }
+  for (int i = 0; i < 4; i++) {
+    numberText(s.qAnswers[i], sizeof(s.qAnswers[i]), options[i]);
+  }
+}
