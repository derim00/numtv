+void Channels::addStory(const char* tag, const char* t, const char* inset,
+                        uint8_t mood) {
+  int index;
+  if (s.storyCount < k_maxStories) {
+    index = (s.storyFirst + s.storyCount) % k_maxStories;
+    s.storyCount++;
+  } else {
+    index = s.storyFirst;
+    s.storyFirst = (s.storyFirst + 1) % k_maxStories;
+  }
+  Story& st = s.stories[index];
+  strlcpy(st.tag, tag, sizeof(st.tag));
+  strlcpy(st.text, t, sizeof(st.text));
+  strlcpy(st.inset, inset, sizeof(st.inset));
+  st.mood = mood;
+}
+
+void Channels::collectNews(bool flashSpecial) {
+  uint32_t produced = Food::produced();
+  uint32_t from = s.foodSeen;
+  if (produced - from > 6) {
+    from = produced - 6;
+  }
+  bool any = false;
+  for (uint32_t i = from; i < produced; i++) {
+    const Food::Entry* e = Food::at(i);
+    if (e) {
+      addCalcStory(e->input, e->output);
+      any = true;
+    }
+  }
+  s.foodSeen = produced;
+  if (any) {
+    s.storyShown = 0;
+    s.storyStart = s.now;
+    if (flashSpecial) {
+      s.flashSpecialUntil = s.now + 3800;
+    }
+  }
+}
