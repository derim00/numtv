+// The story at `index` of the playlist (newest calculation stories first)
+void storyAt(int index, const char** tag, const char** body,
+             const char** inset, uint8_t* mood) {
+  if (index < s.storyCount) {
+    const Story& st =
+        s.stories[(s.storyFirst + s.storyCount - 1 - index) % k_maxStories];
+    *tag = st.tag;
+    *body = st.text;
+    *inset = st.inset;
+    *mood = st.mood;
+    return;
+  }
+  int f = (s.fakeStory + index - s.storyCount) % count(k_fakeNews);
+  *tag = k_fakeNews[f][0];
+  *body = k_fakeNews[f][1];
+  *inset = nullptr;
+  *mood = 0;
+}
