+         Align::Center);
+    text(b, appName(index), 160, 126, rgb(0xFFFFFF), Large, Align::Center, 300);
+    wrapped(b, "Interdit aux profs. Sauf s'ils jouent bien.", 20, 152, 280,
+            rgb(0xE0E0E0), Small, 15, Align::Center, 2);
+    if (examMode()) {
+      // Scrambled, like a pay channel without the decoder
+      for (int y = b.clip().y; y < b.clip().bottom(); y++) {
+        KDColor* row = b.row(y);
+        int shift = static_cast<int>(hash(y * 7 + s.now / 90) % 40) - 20;
+        if (shift > 0) {
+          for (int x = k_screenWidth - 1; x >= shift; x--) {
