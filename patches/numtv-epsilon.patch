+void renderFire(Band& b) {
+  // Stone wall
+  for (int y = b.clip().y; y < b.clip().bottom(); y++) {
+    KDColor* row = b.row(y);
+    int course = y / 14;
+    for (int x = 0; x < k_screenWidth; x++) {
+      int bx = (x + (course % 2) * 14) % 28;
+      bool joint = (y % 14) == 0 || bx == 0;
+      uint32_t h = hash(course * 97 + (x + (course % 2) * 14) / 28);
+      row[x] = joint ? rgb(0x2A1C14) : mix(rgb(0x6A4A36), rgb(0x8A6448), h & 0xFF);
+    }
+  }
+  // The mantelpiece
+  fill(b, {14, 30, 292, 18}, rgb(0x3A2418));
+  fill(b, {14, 46, 292, 4}, rgb(0x1E120C));
+  text(b, "AMBIANCE - FEU DE CHEMIN\xC3\x89\x45 - 8 H", 160, 32,
+       rgb(0xFFD8A8), Small, Align::Center);
+  channelBug(b, "NUM 8", 0xFFB070);
+  // The hearth
+  constexpr int fx = 160 - k_fireW * k_fireScale / 2;
+  constexpr int fy = 220 - k_fireH * k_fireScale;
+  roundFill(b, {fx - 10, fy - 14, k_fireW * k_fireScale + 20, 240 - fy + 14}, 14,
+            rgb(0x1A0E08));
+  int lo = b.clip().y > fy ? b.clip().y : fy;
+  int hi = b.clip().bottom() < 220 ? b.clip().bottom() : 220;
+  KDColor palette[37];
+  for (int v = 0; v < 37; v++) {
+    palette[v] = fireColor(v, 0, 0);
+  }
+  for (int y = lo; y < hi; y++) {
+    KDColor* row = b.row(y);
+    const uint8_t* cells = s.fire + ((y - fy) / k_fireScale) * k_fireW;
+    for (int x = 0; x < k_fireW * k_fireScale; x++) {
+      int v = cells[x / k_fireScale];
+      row[fx + x] = s.fuel == 3 ? fireColor(v, x, y) : palette[v];
+    }
+  }
+  // Logs and embers
+  line(b, 100, 214, 220, 204, 12, rgb(0x4A2A14));
+  line(b, 104, 202, 216, 216, 12, rgb(0x5A3418));
+  ellipse(b, 100, 214, 6, 6, rgb(0xC08A50));
+  ellipse(b, 216, 216, 6, 6, rgb(0xC08A50));
+  for (int i = 0; i < 10; i++) {
+    int ex = 96 + (hash(i * 13) % 128);
+    int a = 120 + (hash(i * 7 + s.now / 180) & 127);
+    disc(b, ex, 220 + (i % 3), 2, rgb(0xFF6A1A), a);
+  }
+  fill(b, {fx - 10, 220, k_fireW * k_fireScale + 20, 20}, rgb(0x241610));
+  char fuel[40];
+  Str m(fuel, sizeof(fuel));
+  m.add("< ").add(k_fuels[s.fuel]).add(" >");
+  text(b, fuel, 160, 223, rgb(0xFFD8A8), Small, Align::Center);
+  if (s.fuel == 1) {
+    // Burning exam papers fly away
+    for (int i = 0; i < 5; i++) {
+      float px = 100 + (hash(i * 31) % 120) + sinf(s.now * 0.002f + i) * 12;
+      float py = fy + 120 - fmodf(s.now * 0.04f + i * 37, 130);
+      fill(b, {static_cast<int>(px), static_cast<int>(py), 9, 11}, rgb(0xFFFFFF), 200);
+      text(b, i % 2 ? "2" : "0", static_cast<int>(px) + 1, static_cast<int>(py) - 2,
+           rgb(0xE0262F), Small);
+    }
+  }
+}
